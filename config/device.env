KBROWSER_DEVICE=${KBROWSER_DEVICE:-}
KBROWSER_MAIN_DISPLAY=0
KBROWSER_SECONDARY_DISPLAY=2
KBROWSER_DISPLAY_WIDTH=1920
KBROWSER_DISPLAY_HEIGHT=1280
KBROWSER_MIN_SDK=31
KBROWSER_ABI=arm64-v8a

if [ -n "${PROJECT_DIR:-}" ] && [ -f "$PROJECT_DIR/config/device.local.env" ]; then
  . "$PROJECT_DIR/config/device.local.env"
fi
