+    @Synchronized
+    fun performTextContextAction(view: View, actionId: Int): Boolean {
+        val input = session?.textInput ?: return false
+        if (input.view !== view) input.setView(view)
+        view.requestFocus()
+        val connection = input.onCreateInputConnection(EditorInfo()) ?: return false
+        return connection.performContextMenuAction(actionId)
+    }
+
+    @Synchronized
+    fun commitText(view: View, text: String): Boolean {
+        val input = session?.textInput ?: return false
+        if (input.view !== view) input.setView(view)
+        view.requestFocus()
+        val connection = input.onCreateInputConnection(EditorInfo()) ?: return false
+        return connection.commitText(text, 1)
+    }
+
     @Synchronized
