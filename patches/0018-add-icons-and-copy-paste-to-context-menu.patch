+    private fun performTextAction(actionId: Int, successMessage: String) {
+        val performed = DualScreenCoordinator.performTextContextAction(browserSurface, actionId)
+        val committed = if (!performed && actionId == android.R.id.paste) {
+            val clipboard = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
+            val text = clipboard.primaryClip?.getItemAt(0)?.coerceToText(this)?.toString()
+            !text.isNullOrEmpty() && DualScreenCoordinator.commitText(browserSurface, text)
+        } else {
+            false
+        }
