+    /** Saves into Fenix's real Places bookmark store, shared with its normal bookmark UI. */
+    private fun addCurrentPageBookmark() {
+        val url = DualScreenCoordinator.currentUrl()
+        if (!url.startsWith("http://") && !url.startsWith("https://")) {
+            Toast.makeText(this, "当前页面不能收藏", Toast.LENGTH_SHORT).show()
+            return
+        }
+        val title = addressField?.text?.toString()?.takeIf { it.isNotBlank() } ?: url
+        CoroutineScope(Dispatchers.Main).launch {
+            val result = withContext(Dispatchers.IO) {
+                components.useCases.bookmarksUseCases.addBookmark(url = url, title = title)
+            }
+            Toast.makeText(
+                this@DualScreenBrowserActivity,
+                if (result.guidToEdit != null) "已收藏到书签" else "该页面已在书签中",
+                Toast.LENGTH_SHORT,
+            ).show()
+        }
+    }
