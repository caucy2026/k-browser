+    /** Opens Android's completed/in-progress download list without leaving the shared page. */
+    private fun openDownloads() {
+        runCatching {
+            startActivity(Intent(DownloadManager.ACTION_VIEW_DOWNLOADS))
+        }.onFailure {
+            Toast.makeText(this, "当前没有可查看的下载", Toast.LENGTH_SHORT).show()
+        }
+    }
+
+    /** Enqueues a link with the system DownloadManager so direct file links work on both modes. */
+    internal fun downloadUrl(url: String) {
+        if (!url.startsWith("http://") && !url.startsWith("https://")) {
+            Toast.makeText(this, "此链接不能下载", Toast.LENGTH_SHORT).show()
+            return
+        }
+        val fileName = URLUtil.guessFileName(url, null, null).ifBlank { "kemi-download" }
+        val request = DownloadManager.Request(android.net.Uri.parse(url)).apply {
+            setTitle(fileName)
+            setDescription("保存到 Download/双屏浏览器")
+            setNotificationVisibility(DownloadManager.Request.VISIBILITY_VISIBLE_NOTIFY_COMPLETED)
+            setAllowedOverMetered(true)
+            setAllowedOverRoaming(false)
+            setDestinationInExternalPublicDir(
+                Environment.DIRECTORY_DOWNLOADS,
+                "双屏浏览器/$fileName",
+            )
+            addRequestHeader("Referer", DualScreenCoordinator.currentUrl())
+        }
+        runCatching {
+            (getSystemService(Context.DOWNLOAD_SERVICE) as DownloadManager).enqueue(request)
+        }.onSuccess {
+            Toast.makeText(
+                this,
+                "已加入下载：Download/双屏浏览器/$fileName",
+                Toast.LENGTH_LONG,
+            ).show()
+        }.onFailure {
+            Log.w("KBrowserDownload", "Unable to enqueue download url=$url", it)
+            Toast.makeText(this, "下载启动失败", Toast.LENGTH_SHORT).show()
+        }
+    }
