+            val bookmarks = withContext(Dispatchers.IO) {
+                components.core.bookmarksStorage.getTree(BookmarkRoot.Mobile.id).getOrNull()
+                    ?.children
+                    .orEmpty()
+                    .filter { !it.url.isNullOrBlank() }
+                    .map {
+                        BookmarkListItem(
+                            guid = it.guid,
+                            title = it.title?.ifBlank { it.url.orEmpty() } ?: it.url.orEmpty(),
+                            url = it.url.orEmpty(),
