+    private fun confirmDeleteBookmark(bookmark: BookmarkListItem, bookmarksDialog: AlertDialog) {
+        AlertDialog.Builder(this)
+            .setTitle("删除收藏？")
+            .setMessage("“${bookmark.title}”将从收藏夹移除。")
+            .setNegativeButton("取消", null)
+            .setPositiveButton("删除") { _, _ ->
+                CoroutineScope(Dispatchers.Main).launch {
+                    val deleted = withContext(Dispatchers.IO) {
+                        components.core.bookmarksStorage.deleteNode(bookmark.guid).getOrDefault(false)
+                    }
+                    if (deleted) {
+                        bookmarksDialog.dismiss()
+                        Toast.makeText(this@DualScreenBrowserActivity, "已删除收藏", Toast.LENGTH_SHORT).show()
+                        showBookmarks()
+                    } else {
+                        Toast.makeText(this@DualScreenBrowserActivity, "删除失败，请重试", Toast.LENGTH_SHORT).show()
+                    }
+                }
+            }
+            .show()
+    }
