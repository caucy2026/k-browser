+    private fun queryDownloads(): List<DownloadListItem> {
+        val manager = getSystemService(Context.DOWNLOAD_SERVICE) as DownloadManager
+        val rows = mutableListOf<DownloadListItem>()
+        manager.query(DownloadManager.Query())?.use { cursor ->
+            val titleColumn = cursor.getColumnIndex(DownloadManager.COLUMN_TITLE)
+            val statusColumn = cursor.getColumnIndexOrThrow(DownloadManager.COLUMN_STATUS)
+            val downloadedColumn = cursor.getColumnIndexOrThrow(DownloadManager.COLUMN_BYTES_DOWNLOADED_SO_FAR)
+            val totalColumn = cursor.getColumnIndexOrThrow(DownloadManager.COLUMN_TOTAL_SIZE_BYTES)
+            val modifiedColumn = cursor.getColumnIndexOrThrow(DownloadManager.COLUMN_LAST_MODIFIED_TIMESTAMP)
+            while (cursor.moveToNext()) {
+                rows.add(DownloadListItem(
+                    title = if (titleColumn >= 0) cursor.getString(titleColumn).orEmpty() else "",
+                    status = cursor.getInt(statusColumn),
+                    downloaded = cursor.getLong(downloadedColumn),
+                    total = cursor.getLong(totalColumn),
+                    modified = cursor.getLong(modifiedColumn),
+                ))
+            }
+        }
+        return rows.sortedByDescending { it.modified }.take(100)
+    }
