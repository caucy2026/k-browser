+    override fun onNewIntent(intent: Intent) {
+        super.onNewIntent(intent)
+        setIntent(intent)
+        val url = intent.getStringExtra(EXTRA_URL)
+            ?: intent.data?.getQueryParameter("url")
+            ?: DualScreenCoordinator.currentUrl()
+        DualScreenCoordinator.attach(this, url)
+        registerCurrentSurface()
+        if (!isTopDisplay) launchTopDisplay(url)
+    }
+
+    override fun onResume() {
+        super.onResume()
+        // singleTask/singleInstance activities can survive while the Gecko
+        // session and EGL compositor are recreated. SurfaceView will not emit
+        // surfaceCreated again in that case, so always rebind its live Surface.
+        registerCurrentSurface()
+    }
+
+    private fun registerCurrentSurface() {
+        if (::browserSurface.isInitialized && browserSurface.holder.surface.isValid) {
+            DualScreenCoordinator.outputAvailable(this, browserSurface.holder.surface)
+        }
+    }
