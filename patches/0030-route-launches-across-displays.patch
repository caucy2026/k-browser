--- /dev/null
+++ b/app/src/main/java/org/mozilla/fenix/dualscreen/DualScreenLaunchActivity.kt
@@ -0,0 +1,69 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.dualscreen
+
+import android.app.Activity
+import android.app.ActivityOptions
+import android.content.Intent
+import android.content.pm.ActivityInfo
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+import android.view.Display
+
+/**
+ * Launcher-only trampoline for the dual-screen browser.
+ *
+ * The target vehicle ROM binds a launcher task to the display where the icon was clicked. Moving
+ * that same task from Display 2 to Display 0 makes WindowManager reject the windows and both
+ * activities disappear. Keep the launcher in a separate task, remove it first, and only then
+ * create the controller task on Display 0 from the application context.
+ */
+class DualScreenLaunchActivity : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        requestedOrientation = ActivityInfo.SCREEN_ORIENTATION_LANDSCAPE
+
+        val originDisplayId = display?.displayId ?: Display.DEFAULT_DISPLAY
+        val appContext = applicationContext
+        val controllerIntent = Intent(intent).apply {
+            setClass(appContext, DualScreenBrowserActivity::class.java)
+            addFlags(
+                Intent.FLAG_ACTIVITY_NEW_TASK or
+                    Intent.FLAG_ACTIVITY_CLEAR_TOP or
+                    Intent.FLAG_ACTIVITY_NO_USER_ACTION,
+            )
+        }
+        val controllerOptions = ActivityOptions.makeBasic().apply {
+            launchDisplayId = Display.DEFAULT_DISPLAY
+        }.toBundle()
+
+        Log.i(TAG, "Route dual-screen launch from display $originDisplayId to display 0")
+        if (originDisplayId == Display.DEFAULT_DISPLAY) {
+            appContext.startActivity(controllerIntent, controllerOptions)
+            finishAndRemoveTask()
+            return
+        }
+
+        // Let WindowManager fully detach the launcher task from Display 2 before creating the
+        // controller task. A separate task affinity plus this short delay avoids the OEM ROM's
+        // cross-display task-affinity race.
+        finishAndRemoveTask()
+        MAIN_HANDLER.postDelayed(
+            {
+                Log.i(TAG, "Start dual-screen controller on display 0")
+                appContext.startActivity(controllerIntent, controllerOptions)
+            },
+            SECONDARY_DISPLAY_RELEASE_DELAY_MS,
+        )
+    }
+
+    private companion object {
+        const val TAG = "KBrowserLaunch"
+        const val SECONDARY_DISPLAY_RELEASE_DELAY_MS = 400L
+        val MAIN_HANDLER = Handler(Looper.getMainLooper())
+    }
+}
