+    private fun configureTargetHardwareWindow() {
+        window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
+        window.setBackgroundDrawable(ColorDrawable(Color.WHITE))
+        val targetMode = display?.supportedModes?.firstOrNull {
+            it.physicalWidth == TARGET_WIDTH_PX &&
+                it.physicalHeight == TARGET_VIEWPORT_HEIGHT_PX &&
+                kotlin.math.abs(it.refreshRate - TARGET_REFRESH_RATE) < 0.1f
+        }
+        if (targetMode != null) {
+            window.attributes = window.attributes.apply {
+                preferredDisplayModeId = targetMode.modeId
+                preferredRefreshRate = TARGET_REFRESH_RATE
+            }
+        }
+    }
