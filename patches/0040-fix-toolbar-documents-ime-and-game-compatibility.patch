+    private fun dismissKeyboardForBack(): Boolean {
+        val visible = keyboardVisible || window.decorView.rootWindowInsets?.isVisible(WindowInsets.Type.ime()) == true
+        if (visible) {
+            window.insetsController?.hide(WindowInsets.Type.ime())
+            (getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager)
+                .hideSoftInputFromWindow((currentFocus ?: rootLayout).windowToken, 0)
+            keyboardHiddenAt = SystemClock.uptimeMillis()
+            return true
+        }
+        // Some S1 IMEs hide themselves, then deliver the same Back to the Activity.
+        return keyboardHiddenAt > 0 && SystemClock.uptimeMillis() - keyboardHiddenAt < 300
+    }
+
