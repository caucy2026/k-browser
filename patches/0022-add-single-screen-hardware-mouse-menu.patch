+
+    private fun showHardwareMouseTextMenu() {
+        val root = findViewById<FrameLayout>(android.R.id.content) ?: return
+        val textTarget = currentFocus
+        val anchor = View(this).apply {
+            layoutParams = FrameLayout.LayoutParams(1, 1).apply {
+                leftMargin = lastMouseX.toInt().coerceIn(0, (root.width - 1).coerceAtLeast(0))
+                topMargin = lastMouseY.toInt().coerceIn(0, (root.height - 1).coerceAtLeast(0))
+            }
+        }
+        root.addView(anchor)
+        anchor.post {
+            if (anchor.parent == null || isFinishing) return@post
+            PopupMenu(this, anchor).apply {
+                setForceShowIcon(true)
+                menu.add(0, android.R.id.copy, 0, "复制所选内容")
+                    .setIcon(android.R.drawable.ic_menu_edit)
+                menu.add(0, android.R.id.paste, 1, "粘贴")
+                    .setIcon(android.R.drawable.ic_menu_send)
+                    .isEnabled = (getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager)
+                    .hasPrimaryClip()
+                menu.add(0, android.R.id.selectAll, 2, "全选")
+                    .setIcon(android.R.drawable.ic_menu_set_as)
+                setOnMenuItemClickListener { item ->
+                    val success = if (item.itemId == android.R.id.copy) {
+                        performFocusedCopy(textTarget)
+                    } else {
+                        performFocusedTextAction(textTarget, item.itemId)
+                    }
+                    Toast.makeText(
+                        this@HomeActivity,
+                        if (success) {
+                            if (item.itemId == android.R.id.paste) "已粘贴" else "已复制"
+                        } else {
+                            if (item.itemId == android.R.id.copy) "请先选择要复制的内容"
+                            else "当前页面没有可操作的文字输入位置"
+                        },
+                        Toast.LENGTH_SHORT,
+                    ).show()
+                    true
+                }
+                setOnDismissListener { root.removeView(anchor) }
+                show()
+            }
+        }
+    }
+
+    private fun performFocusedTextAction(target: View?, actionId: Int): Boolean {
+        target ?: return false
+        val connection = target.onCreateInputConnection(EditorInfo()) ?: return false
+        return connection.performContextMenuAction(actionId)
+    }
+
+    private fun performFocusedCopy(target: View?): Boolean {
+        val clipboard = getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
+        val beforeTimestamp = clipboard.primaryClipDescription?.timestamp
+        val reportedSuccess = performFocusedTextAction(target, android.R.id.copy)
+        val afterTimestamp = clipboard.primaryClipDescription?.timestamp
+        return reportedSuccess ||
+            (clipboard.hasPrimaryClip() && afterTimestamp != null && afterTimestamp != beforeTimestamp)
+    }
