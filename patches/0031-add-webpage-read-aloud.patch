+package org.mozilla.fenix.dualscreen;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Produces natural TTS request units without cutting ordinary sentences by length. */
+public final class SpeechTextSegmenter {
+    // This is only a last-resort transport guard for pathological text with no
+    // punctuation at all. Normal prose is split exclusively at punctuation.
+    static final int HARD_REQUEST_LIMIT = 800;
+    // The first cloud request controls perceived latency. Keep only the first
+    // natural clause in that request and let the normal sentence-sized queue
+    // continue behind it.
+    static final int FIRST_REQUEST_TARGET = 64;
+
+    private SpeechTextSegmenter() { }
+
+    public static List<String> split(String text) {
+        List<String> result = new ArrayList<>();
+        if (text == null || text.trim().isEmpty())
+            return result;
+        int start = skipWhitespace(text, 0);
+        for (int index = start; index < text.length(); index++) {
+            if (!isSpeechBoundary(text, index))
+                continue;
+            int end = consumeBoundarySuffix(text, index + 1);
+            appendBounded(result, text.substring(start, end).trim());
+            start = skipWhitespace(text, end);
+            index = start - 1;
+        }
+        if (start < text.length())
+            appendBounded(result, text.substring(start).trim());
+        prioritizeFirstRequest(result);
+        return result;
+    }
+
+    private static void prioritizeFirstRequest(List<String> result) {
+        if (result.isEmpty() || result.get(0).length() <= FIRST_REQUEST_TARGET)
+            return;
+        String first = result.remove(0);
+        int split = -1;
+        // Prefer a complete clause near the target instead of an arbitrary
+        // byte/character boundary. Minor punctuation has already been kept in
+        // the phrase by split(), so scan it again before falling back to space.
+        for (int index = 12; index < Math.min(first.length(), FIRST_REQUEST_TARGET); index++) {
+            char value = first.charAt(index);
+            if (isFirstRequestBoundary(first, index)) {
+                split = consumeBoundarySuffix(first, index + 1);
+                break;
+            }
+        }
+        if (split < 0)
+            split = lastWhitespaceBefore(first, 0, FIRST_REQUEST_TARGET);
+        if (split <= 0)
+            split = Math.min(FIRST_REQUEST_TARGET, first.length());
+        result.add(0, first.substring(split).trim());
+        result.add(0, first.substring(0, split).trim());
+    }
+
+    private static boolean isFirstRequestBoundary(String text, int index) {
+        char value = text.charAt(index);
+        if (isSpeechBoundary(text, index) || value == '，' || value == '、'
+                || value == '：' || value == ':' || value == ',') {
+            if (value == ',') {
+                return index == 0 || index + 1 >= text.length()
+                        || !Character.isDigit(text.charAt(index - 1))
+                        || !Character.isDigit(text.charAt(index + 1));
+            }
+            return true;
+        }
+        return false;
+    }
+
+    private static boolean isSpeechBoundary(String text, int index) {
+        char value = text.charAt(index);
+        if (value == '\n' || value == '。' || value == '！' || value == '？'
+                || value == '；' || value == '!' || value == '?' || value == ';')
+            return true;
+        if (value == '.') {
+            // Keep decimal numbers intact (3.14).
+            return index == 0 || index + 1 >= text.length()
+                    || !Character.isDigit(text.charAt(index - 1))
+                    || !Character.isDigit(text.charAt(index + 1));
+        }
+        return value == '…';
+    }
+
+    private static int consumeBoundarySuffix(String text, int offset) {
+        int end = offset;
+        while (end < text.length()) {
+            char value = text.charAt(end);
+            if (isRepeatedPunctuation(value) || isClosingMark(value))
+                end++;
+            else
+                break;
+        }
+        return end;
+    }
+
+    private static boolean isRepeatedPunctuation(char value) {
+        return value == '。' || value == '！' || value == '？' || value == '!'
+                || value == '?' || value == '.' || value == '…';
+    }
+
+    private static boolean isClosingMark(char value) {
+        return value == '”' || value == '’' || value == '"' || value == '\''
+                || value == ')' || value == '）' || value == ']' || value == '】'
+                || value == '》' || value == '〉' || value == '」' || value == '』';
+    }
+
+    private static int skipWhitespace(String text, int offset) {
+        int index = offset;
+        while (index < text.length() && Character.isWhitespace(text.charAt(index)))
+            index++;
+        return index;
+    }
+
+    private static void appendBounded(List<String> result, String phrase) {
+        if (phrase.isEmpty())
+            return;
+        int start = 0;
+        while (phrase.length() - start > HARD_REQUEST_LIMIT) {
+            int limit = start + HARD_REQUEST_LIMIT;
+            int split = lastWhitespaceBefore(phrase, start, limit);
+            if (split <= start)
+                split = limit; // Unavoidable only for an over-limit token.
+            String part = phrase.substring(start, split).trim();
+            if (!part.isEmpty())
+                result.add(part);
+            start = skipWhitespace(phrase, split);
+        }
+        String tail = phrase.substring(start).trim();
+        if (!tail.isEmpty())
+            result.add(tail);
+    }
+
+    private static int lastWhitespaceBefore(String text, int start, int limit) {
+        for (int index = limit; index > start; index--) {
+            if (Character.isWhitespace(text.charAt(index - 1)))
+                return index - 1;
+        }
+        return -1;
+    }
+}

