diff --git a/app/src/main/assets/kbrowser_tts/content.js b/app/src/main/assets/kbrowser_tts/content.js
new file mode 100644
index 0000000000000000000000000000000000000000..7831b5b10c455aa9c28a1d313aa423791a776f6a
--- /dev/null
+++ b/app/src/main/assets/kbrowser_tts/content.js
@@ -0,0 +1,113 @@
+(function () {
+  "use strict";
+
+  const MAX_TEXT_CHARS = 500000;
+  const BLOCK_SELECTOR = [
+    "h1", "h2", "h3", "h4", "h5", "h6", "p", "li", "blockquote",
+    "pre", "td", "th", "figcaption", "article", "main"
+  ].join(",");
+  let highlighted = null;
+
+  function normalize(value) {
+    return (value || "").replace(/\s+/g, " ").trim();
+  }
+
+  function isReadable(element) {
+    if (!element || !element.isConnected) return false;
+    if (element.closest("script,style,noscript,template,[aria-hidden='true']")) return false;
+    const style = window.getComputedStyle(element);
+    return style.display !== "none" && style.visibility !== "hidden" &&
+      Number(style.opacity || "1") !== 0;
+  }
+
+  function collectBlocks() {
+    const candidates = Array.from(document.querySelectorAll(BLOCK_SELECTOR));
+    const blocks = [];
+    const seen = new Set();
+    for (const element of candidates) {
+      if (!isReadable(element)) continue;
+      // Skip broad article/main containers when they contain smaller semantic blocks.
+      if ((element.matches("article,main")) && element.querySelector(BLOCK_SELECTOR)) continue;
+      const text = normalize(element.innerText || element.textContent);
+      if (!text || seen.has(text)) continue;
+      const rect = element.getBoundingClientRect();
+      if (rect.width <= 0 || rect.height <= 0) continue;
+      seen.add(text);
+      blocks.push({ element, text, top: rect.top, bottom: rect.bottom });
+    }
+    if (blocks.length === 0 && isReadable(document.body)) {
+      const text = normalize(document.body.innerText || document.body.textContent);
+      if (text) blocks.push({ element: document.body, text, top: 0, bottom: 1 });
+    }
+    return blocks;
+  }
+
+  function extractFromViewport() {
+    const blocks = collectBlocks();
+    let start = blocks.findIndex(block => block.bottom >= 0);
+    if (start < 0) start = 0;
+    let result = "";
+    for (let index = start; index < blocks.length; index++) {
+      const next = blocks[index].text;
+      if (!next) continue;
+      if (result.length + next.length + 1 > MAX_TEXT_CHARS) {
+        result += "\n" + next.slice(0, Math.max(0, MAX_TEXT_CHARS - result.length - 1));
+        break;
+      }
+      result += (result ? "\n" : "") + next;
+    }
+    return result;
+  }
+
+  function clearHighlight() {
+    if (!highlighted) return;
+    highlighted.style.removeProperty("background-color");
+    highlighted.style.removeProperty("box-shadow");
+    highlighted.style.removeProperty("scroll-margin-top");
+    highlighted = null;
+  }
+
+  function follow(text) {
+    clearHighlight();
+    const needle = normalize(text).slice(0, 36);
+    if (!needle) return;
+    const blocks = collectBlocks();
+    const target = blocks.find(block => block.text.includes(needle)) ||
+      blocks.find(block => needle.includes(block.text.slice(0, 24)));
+    if (!target) return;
+    highlighted = target.element;
+    highlighted.style.setProperty("background-color", "#EAF2FF", "important");
+    highlighted.style.setProperty("box-shadow", "inset 4px 0 #1F69E0", "important");
+    highlighted.style.setProperty("scroll-margin-top", "180px", "important");
+    const rect = highlighted.getBoundingClientRect();
+    if (rect.top < 120 || rect.bottom > window.innerHeight - 100) {
+      highlighted.scrollIntoView({ behavior: "smooth", block: "center", inline: "nearest" });
+    }
+  }
+
+  function connect() {
+    let port;
+    try {
+      port = browser.runtime.connectNative("kbrowser_tts");
+    } catch (_) {
+      return;
+    }
+    port.onMessage.addListener(message => {
+      if (!message || !message.type) return;
+      if (message.type === "extract") {
+        port.postMessage({
+          type: "pageText",
+          requestId: message.requestId,
+          text: extractFromViewport()
+        });
+      } else if (message.type === "follow") {
+        follow(message.text || "");
+      } else if (message.type === "clear") {
+        clearHighlight();
+      }
+    });
+    port.onDisconnect.addListener(() => window.setTimeout(connect, 500));
+  }
+
+  connect();
+})();
