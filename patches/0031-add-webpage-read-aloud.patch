+package org.mozilla.fenix.dualscreen;
+
+import android.content.Context;
+import android.media.AudioAttributes;
+import android.media.AudioFormat;
+import android.media.AudioManager;
+import android.media.AudioTrack;
+import android.provider.Settings;
+import android.util.Base64;
+import android.util.Log;
+
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.io.ByteArrayOutputStream;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.Locale;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicLong;
+
+import okhttp3.Call;
+import okhttp3.HttpUrl;
+import okhttp3.MediaType;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.RequestBody;
+import okhttp3.Response;
+import okhttp3.WebSocket;
+import okhttp3.WebSocketListener;
+
+/** Streaming iFlytek AIUI TTS backed by system-provisioned Settings.Global credentials. */
+public final class IflytekTtsEngine {
+    private static final String TAG = "KBrowserIflytekTts";
+    private static final String SETTINGS_KEY = "iflytek_params";
+    private static final String AUTH_URL = "http://api.voice.gskiot.com/voice-api/voice/auth";
+    // OkHttp represents a WebSocket handshake as an HTTP URL internally and
+    // upgrades it when newWebSocket() is called.
+    private static final String WS_HANDSHAKE_URL = "http://wsapi.xfyun.cn/v1/aiui";
+    private static final MediaType JSON = MediaType.get("application/json; charset=utf-8");
+    private static final AtomicLong AUTHORIZED_UNTIL = new AtomicLong();
+
+    public interface Listener {
+        void onStarted();
+        void onDone();
+        void onError(String message);
+    }
+
+    public interface SynthesisListener {
+        void onBuffering();
+        void onReady(PcmClip clip);
+        void onError(String message);
+    }
+
+    public static final class PcmClip {
+        private final byte[] pcm;
+
+        private PcmClip(byte[] pcm) {
+            this.pcm = pcm;
+        }
+    }
+
+    private final Context context;
+    private final OkHttpClient client = new OkHttpClient.Builder()
+            .connectTimeout(12, TimeUnit.SECONDS)
+            .readTimeout(20, TimeUnit.SECONDS)
+            .writeTimeout(20, TimeUnit.SECONDS)
+            .build();
+    private final AtomicInteger generation = new AtomicInteger();
+    private WebSocket webSocket;
+    private AudioTrack audioTrack;
+    private boolean paused;
+    private int samplesWritten;
+    private volatile long playbackStartedAt;
+
+    public IflytekTtsEngine(Context context) {
+        this.context = context.getApplicationContext();
+    }
+
+    public boolean hasSystemCredentials() {
+        String value = Settings.Global.getString(context.getContentResolver(), SETTINGS_KEY);
+        return value != null && !value.trim().isEmpty();
+    }
+
+    public void speak(String text, Listener listener) {
+        stop();
+        final int requestGeneration = generation.incrementAndGet();
+        final long submittedAt = android.os.SystemClock.elapsedRealtime();
+        Log.i(TAG, "TTS request submitted: " + text.length() + " chars");
+        try {
+            Credentials credentials = readCredentials();
+            Log.i(TAG, "Using system-provisioned iFlytek credentials");
+            authenticate(credentials, requestGeneration, text, submittedAt, listener);
+        } catch (Exception exception) {
+            Log.w(TAG, "System iFlytek credentials unavailable", exception);
+            listener.onError(safeMessage(exception, "系统未配置讯飞语音参数"));
+        }
+    }
+
+    /** Synthesizes without playing so the next paragraph can buffer in parallel. */
+    public void synthesize(String text, SynthesisListener listener) {
+        stop();
+        final int requestGeneration = generation.incrementAndGet();
+        try {
+            Credentials credentials = readCredentials();
+            listener.onBuffering();
+            authenticateForSynthesis(credentials, requestGeneration, text, listener);
+        } catch (Exception exception) {
+            listener.onError(safeMessage(exception, "系统未配置讯飞语音参数"));
+        }
+    }
+
+    /** Plays an already synthesized clip while another engine buffers the next one. */
+    public void play(PcmClip clip, Listener listener) {
+        stop();
+        final int requestGeneration = generation.incrementAndGet();
+        prepareAudio();
+        listener.onStarted();
+        client.dispatcher().executorService().execute(() -> {
+            AudioTrack current = audioTrack;
+            if (current == null || !isCurrent(requestGeneration))
+                return;
+            startAudio(current);
+            int written = current.write(clip.pcm, 0, clip.pcm.length, AudioTrack.WRITE_BLOCKING);
+            if (written > 0)
+                samplesWritten = written / 2;
+            finishAfterPlayback(requestGeneration, listener);
+        });
+    }
+
+    public void pause() {
+        paused = true;
+        AudioTrack current = audioTrack;
+        if (current != null && current.getPlayState() == AudioTrack.PLAYSTATE_PLAYING)
+            current.pause();
+    }
+
+    /** Returns false when the paused stream already drained and must be restarted. */
+    public boolean resume() {
+        paused = false;
+        AudioTrack current = audioTrack;
+        if (current != null && current.getState() == AudioTrack.STATE_INITIALIZED) {
+            current.play();
+            boolean resumed = current.getPlayState() == AudioTrack.PLAYSTATE_PLAYING;
+            Log.i(TAG, resumed ? "TTS_AUDIO_RESUMED" : "TTS_AUDIO_RESUME_FAILED");
+            return resumed;
+        }
+        Log.i(TAG, "TTS_AUDIO_RESTART_REQUIRED");
+        return false;
+    }
+
+    public void stop() {
+        generation.incrementAndGet();
+        WebSocket socket = webSocket;
+        webSocket = null;
+        if (socket != null)
+            socket.close(1000, "cancelled");
+        releaseAudio();
+        paused = false;
+    }
+
+    private void authenticate(Credentials credentials, int requestGeneration, String text,
+                              long submittedAt, Listener listener) throws Exception {
+        if (AUTHORIZED_UNTIL.get() > System.currentTimeMillis()) {
+            openWebSocket(credentials, requestGeneration, text, submittedAt, listener);
+            return;
+        }
+        long now = System.currentTimeMillis();
+        JSONObject body = new JSONObject();
+        body.put("xiriSn", credentials.wifiMac);
+        body.put("license", credentials.token);
+        body.put("channel", "NEWLINK01");
+        body.put("devicewifiMac", credentials.wifiMac);
+        body.put("deviceMac", credentials.wifiMac);
+        body.put("sn", credentials.sn);
+        body.put("clientVersion", credentials.systemVersion);
+        body.put("timestamp", Long.toString(now));
+        Request request = new Request.Builder().url(AUTH_URL)
+                .post(RequestBody.create(body.toString(), JSON)).build();
+        client.newCall(request).enqueue(new okhttp3.Callback() {
+            @Override
+            public void onFailure(Call call, IOException exception) {
+                if (isCurrent(requestGeneration))
+                    listener.onError("讯飞鉴权网络异常");
+            }
+
+            @Override
+            public void onResponse(Call call, Response response) {
+                try (Response closeable = response) {
+                    String responseText = closeable.body() == null ? "" : closeable.body().string();
+                    JSONObject result = new JSONObject(responseText);
+                    JSONObject data = result.optJSONObject("data");
+                    if (!closeable.isSuccessful() || !"00000".equals(result.optString("code"))
+                            || data == null || data.optInt("status", -1) != 0) {
+                        throw new IOException("讯飞鉴权失败");
+                    }
+                    if (isCurrent(requestGeneration))
+                        Log.i(TAG, "Device authentication succeeded");
+                    AUTHORIZED_UNTIL.set(System.currentTimeMillis() + TimeUnit.MINUTES.toMillis(5));
+                    if (isCurrent(requestGeneration))
+                        openWebSocket(credentials, requestGeneration, text, submittedAt, listener);
+                } catch (Exception exception) {
+                    Log.w(TAG, "Device authentication failed", exception);
+                    if (isCurrent(requestGeneration))
+                        listener.onError(safeMessage(exception, "讯飞鉴权失败"));
+                }
+            }
+        });
+    }
+
+    private void authenticateForSynthesis(Credentials credentials, int requestGeneration,
+                                           String text, SynthesisListener listener)
+            throws Exception {
+        if (AUTHORIZED_UNTIL.get() > System.currentTimeMillis()) {
+            openSynthesisSocket(credentials, requestGeneration, text, listener);
+            return;
+        }
+        long now = System.currentTimeMillis();
+        JSONObject body = new JSONObject();
+        body.put("xiriSn", credentials.wifiMac);
+        body.put("license", credentials.token);
+        body.put("channel", "NEWLINK01");
+        body.put("devicewifiMac", credentials.wifiMac);
+        body.put("deviceMac", credentials.wifiMac);
+        body.put("sn", credentials.sn);
+        body.put("clientVersion", credentials.systemVersion);
+        body.put("timestamp", Long.toString(now));
+        Request request = new Request.Builder().url(AUTH_URL)
+                .post(RequestBody.create(body.toString(), JSON)).build();
+        client.newCall(request).enqueue(new okhttp3.Callback() {
+            @Override
+            public void onFailure(Call call, IOException exception) {
+                if (isCurrent(requestGeneration))
+                    listener.onError("讯飞鉴权网络异常");
+            }
+
+            @Override
+            public void onResponse(Call call, Response response) {
+                try (Response closeable = response) {
+                    String responseText = closeable.body() == null ? "" : closeable.body().string();
+                    JSONObject result = new JSONObject(responseText);
+                    JSONObject data = result.optJSONObject("data");
+                    if (!closeable.isSuccessful() || !"00000".equals(result.optString("code"))
+                            || data == null || data.optInt("status", -1) != 0)
+                        throw new IOException("讯飞鉴权失败");
+                    AUTHORIZED_UNTIL.set(System.currentTimeMillis()
+                            + TimeUnit.MINUTES.toMillis(5));
+                    if (isCurrent(requestGeneration))
+                        openSynthesisSocket(credentials, requestGeneration, text, listener);
+                } catch (Exception exception) {
+                    if (isCurrent(requestGeneration))
+                        listener.onError(safeMessage(exception, "讯飞鉴权失败"));
+                }
+            }
+        });
+    }
+
+    private void openSynthesisSocket(Credentials credentials, int requestGeneration, String text,
+                                     SynthesisListener listener) throws Exception {
+        Request request = new Request.Builder().url(signedWebSocketUrl(credentials))
+                .header("Origin", "http://wsapi.xfyun.cn").build();
+        webSocket = client.newWebSocket(request, new WebSocketListener() {
+            private final ByteArrayOutputStream pcm = new ByteArrayOutputStream();
+            private boolean streamFinished;
+
+            @Override
+            public void onMessage(WebSocket socket, String message) {
+                if (!isCurrent(requestGeneration))
+                    return;
+                try {
+                    JSONObject packet = new JSONObject(message);
+                    int code = parseCode(packet.opt("code"));
+                    if (code != 0)
+                        throw new IOException(packet.optString("desc", "讯飞合成失败"));
+                    if ("started".equals(packet.optString("action"))) {
+                        socket.send(text);
+                        socket.send("--end--");
+                        return;
+                    }
+                    if (!"result".equals(packet.optString("action")))
+                        return;
+                    JSONObject data = packet.optJSONObject("data");
+                    if (data == null)
+                        return;
+                    String content = data.optString("content");
+                    if (!content.isEmpty()) {
+                        byte[] bytes = Base64.decode(content, Base64.DEFAULT);
+                        pcm.write(bytes, 0, bytes.length);
+                    }
+                    if (data.optBoolean("is_last", false)) {
+                        streamFinished = true;
+                        if (pcm.size() == 0)
+                            throw new IOException("讯飞未返回语音数据");
+                        Log.i(TAG, "Next TTS segment buffered: " + pcm.size() + " bytes");
+                        listener.onReady(new PcmClip(pcm.toByteArray()));
+                    }
+                } catch (Exception exception) {
+                    socket.cancel();
+                    listener.onError(safeMessage(exception, "讯飞语音缓冲失败"));
+                }
+            }
+
+            @Override
+            public void onFailure(WebSocket socket, Throwable throwable, Response response) {
+                if (!streamFinished && isCurrent(requestGeneration))
+                    listener.onError(safeMessage(throwable, "讯飞语音缓冲失败"));
+            }
+        });
+    }
+
+    private void openWebSocket(Credentials credentials, int requestGeneration, String text,
+                               long submittedAt, Listener listener) throws Exception {
+        Request request = new Request.Builder().url(signedWebSocketUrl(credentials))
+                .header("Origin", "http://wsapi.xfyun.cn").build();
+        webSocket = client.newWebSocket(request, new WebSocketListener() {
+            private boolean streamFinished;
+            private boolean firstPcmLogged;
+
+            @Override
+            public void onMessage(WebSocket socket, String message) {
+                if (!isCurrent(requestGeneration))
+                    return;
+                try {
+                    JSONObject packet = new JSONObject(message);
+                    int code = parseCode(packet.opt("code"));
+                    if (code != 0)
+                        throw new IOException(packet.optString("desc", "讯飞合成失败"));
+                    String action = packet.optString("action");
+                    if ("started".equals(action)) {
+                        prepareAudio();
+                        Log.i(TAG, "AIUI TTS stream started");
+                        listener.onStarted();
+                        socket.send(text);
+                        socket.send("--end--");
+                        return;
+                    }
+                    if (!"result".equals(action))
+                        return;
+                    JSONObject data = packet.optJSONObject("data");
+                    if (data == null)
+                        return;
+                    String content = data.optString("content");
+                    if (!content.isEmpty()) {
+                        byte[] pcm = Base64.decode(content, Base64.DEFAULT);
+                        AudioTrack current = audioTrack;
+                        if (current != null) {
+                            if (!paused && current.getPlayState() != AudioTrack.PLAYSTATE_PLAYING)
+                                startAudio(current);
+                            int written = current.write(pcm, 0, pcm.length,
+                                    AudioTrack.WRITE_BLOCKING);
+                            if (written > 0) {
+                                samplesWritten += written / 2;
+                                if (!firstPcmLogged) {
+                                    firstPcmLogged = true;
+                                    Log.i(TAG, "First PCM queued in "
+                                            + (android.os.SystemClock.elapsedRealtime()
+                                            - submittedAt) + " ms");
+                                }
+                            }
+                        }
+                    }
+                    if (data.optBoolean("is_last", false)) {
+                        streamFinished = true;
+                        Log.i(TAG, "AIUI TTS stream complete, waiting for playback drain");
+                        finishAfterPlayback(requestGeneration, listener);
+                    }
+                } catch (Exception exception) {
+                    socket.cancel();
+                    releaseAudio();
+                    listener.onError(safeMessage(exception, "讯飞语音数据异常"));
+                }
+            }
+
+            @Override
+            public void onFailure(WebSocket socket, Throwable throwable, Response response) {
+                if (streamFinished) {
+                    Log.i(TAG, "AIUI connection closed after final audio packet");
+                    return;
+                }
+                if (isCurrent(requestGeneration)) {
+                    Log.w(TAG, "AIUI TTS WebSocket failed", throwable);
+                    releaseAudio();
+                    listener.onError(safeMessage(throwable, "讯飞语音连接失败"));
+                }
+            }
+        });
+    }
+
+    private HttpUrl signedWebSocketUrl(Credentials credentials) throws Exception {
+        JSONObject param = new JSONObject();
+        param.put("auth_id", credentials.authId);
+        param.put("data_type", "text");
+        param.put("vcn", "x2_xiaojuan");
+        param.put("scene", "IFLYTEK.tts");
+        param.put("tts_aue", "raw");
+        String paramBase64 = Base64.encodeToString(
+                param.toString().getBytes(StandardCharsets.UTF_8), Base64.NO_WRAP);
+        String curtime = Long.toString(System.currentTimeMillis() / 1000L);
+        String checksum = sha256(credentials.apiKey + curtime + paramBase64);
+        return HttpUrl.get(WS_HANDSHAKE_URL).newBuilder()
+                .addQueryParameter("appid", credentials.appId)
+                .addQueryParameter("checksum", checksum)
+                .addQueryParameter("curtime", curtime)
+                .addQueryParameter("param", paramBase64)
+                .addQueryParameter("signtype", "sha256")
+                .build();
+    }
+
+    private void prepareAudio() {
+        releaseAudio();
+        samplesWritten = 0;
+        playbackStartedAt = 0L;
+        int minimum = AudioTrack.getMinBufferSize(16000, AudioFormat.CHANNEL_OUT_MONO,
+                AudioFormat.ENCODING_PCM_16BIT);
+        audioTrack = new AudioTrack.Builder()
+                .setAudioAttributes(new AudioAttributes.Builder()
+                        .setUsage(AudioAttributes.USAGE_ASSISTANCE_ACCESSIBILITY)
+                        .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH).build())
+                .setAudioFormat(new AudioFormat.Builder().setSampleRate(16000)
+                        .setEncoding(AudioFormat.ENCODING_PCM_16BIT)
+                        .setChannelMask(AudioFormat.CHANNEL_OUT_MONO).build())
+                .setBufferSizeInBytes(Math.max(minimum * 4, 32768))
+                .setTransferMode(AudioTrack.MODE_STREAM)
+                .build();
+    }
+
+    private void startAudio(AudioTrack track) {
+        if (playbackStartedAt == 0L)
+            playbackStartedAt = android.os.SystemClock.elapsedRealtime();
+        track.play();
+    }
+
+    private void finishAfterPlayback(int requestGeneration, Listener listener) {
+        AudioTrack current = audioTrack;
+        if (current == null || samplesWritten <= 0) {
+            releaseAudio();
+            listener.onDone();
+            return;
+        }
+        final int targetSamples = samplesWritten;
+        final long startedAt = playbackStartedAt > 0L
+                ? playbackStartedAt : android.os.SystemClock.elapsedRealtime();
+        // PCM is 16 kHz mono 16-bit. Some target firmware resets/freezes
+        // playbackHeadPosition as soon as a short streaming track underruns;
+        // waiting for the head to reach targetSamples then stalls every other
+        // prefetched phrase until the old 30-second timeout. The submitted PCM
+        // duration is authoritative and remains stable across that firmware.
+        final long pcmDurationMillis = Math.max(1L,
+                (targetSamples * 1000L + 15_999L) / 16_000L);
+        client.dispatcher().executorService().execute(() -> {
+            long deadline = Math.max(android.os.SystemClock.elapsedRealtime(),
+                    startedAt + pcmDurationMillis) + 180L;
+            while (isCurrent(requestGeneration)
+                    && android.os.SystemClock.elapsedRealtime() < deadline) {
+                try {
+                    Thread.sleep(10L);
+                } catch (InterruptedException exception) {
+                    Thread.currentThread().interrupt();
+                    break;
+                }
+            }
+            if (isCurrent(requestGeneration)) {
+                releaseAudio();
+                Log.i(TAG, "PCM playback complete samples=" + targetSamples
+                        + " durationMs=" + pcmDurationMillis);
+                listener.onDone();
+            }
+        });
+    }
+
+    private synchronized void releaseAudio() {
+        AudioTrack current = audioTrack;
+        audioTrack = null;
+        playbackStartedAt = 0L;
+        if (current == null)
+            return;
+        try {
+            current.stop();
+        } catch (IllegalStateException ignored) {
+        }
+        current.release();
+    }
+
+    private Credentials readCredentials() throws Exception {
+        String raw = Settings.Global.getString(context.getContentResolver(), SETTINGS_KEY);
+        if (raw == null || raw.trim().isEmpty())
+            throw new IllegalStateException("系统未配置讯飞语音参数");
+        JSONObject root = new JSONObject(raw);
+        JSONObject values = root.optJSONObject("xunfei");
+        if (values == null)
+            values = root;
+        Credentials result = new Credentials();
+        result.token = require(values, "token");
+        result.appId = require(values, "app_id");
+        result.apiKey = require(values, "api_key");
+        result.wifiMac = first(root.optString("wifi_mac"), values.optString("wifi_mac"));
+        if (result.wifiMac.isEmpty())
+            throw new IllegalStateException("系统讯飞参数缺少 wifi_mac");
+        result.wifiMac = result.wifiMac.toLowerCase(Locale.ROOT);
+        result.authId = first(root.optString("auth_id"), values.optString("auth_id"));
+        if (result.authId.isEmpty())
+            result.authId = md5(result.wifiMac.replace(":", ""));
+        result.sn = first(root.optString("sn"), values.optString("sn"));
+        if (result.sn.isEmpty())
+            result.sn = "QUALMETA-" + result.wifiMac.toUpperCase(Locale.ROOT);
+        result.systemVersion = first(root.optString("system_version"),
+                values.optString("system_version"));
+        if (result.systemVersion.isEmpty())
+            result.systemVersion = "KBrowser";
+        return result;
+    }
+
+    private boolean isCurrent(int value) {
+        return generation.get() == value;
+    }
+
+    private static int parseCode(Object value) {
+        if (value == null)
+            return 0;
+        try {
+            return Integer.parseInt(String.valueOf(value));
+        } catch (NumberFormatException exception) {
+            return -1;
+        }
+    }
+
+    private static String require(JSONObject object, String key) {
+        String value = object.optString(key);
+        if (value.isEmpty())
+            throw new IllegalStateException("系统讯飞参数缺少 " + key);
+        return value;
+    }
+
+    private static String first(String first, String second) {
+        return first == null || first.isEmpty() ? (second == null ? "" : second) : first;
+    }
+
+    private static String md5(String value) throws Exception {
+        return hex(MessageDigest.getInstance("MD5").digest(
+                value.getBytes(StandardCharsets.UTF_8)));
+    }
+
+    private static String sha256(String value) throws Exception {
+        return hex(MessageDigest.getInstance("SHA-256").digest(
+                value.getBytes(StandardCharsets.UTF_8)));
+    }
+
+    private static String hex(byte[] bytes) {
+        StringBuilder result = new StringBuilder(bytes.length * 2);
+        for (byte value : bytes)
+            result.append(String.format(Locale.ROOT, "%02x", value & 0xff));
+        return result.toString();
+    }
+
+    private static String safeMessage(Throwable throwable, String fallback) {
+        return throwable.getMessage() == null || throwable.getMessage().trim().isEmpty()
+                ? fallback : throwable.getMessage();
+    }
+
+    private static final class Credentials {
+        String token;
+        String appId;
+        String apiKey;
+        String wifiMac;
+        String authId;
+        String sn;
+        String systemVersion;
+    }
+}
