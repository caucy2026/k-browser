diff --git a/app/src/main/java/org/mozilla/fenix/dualscreen/BrowserReadAloudController.kt b/app/src/main/java/org/mozilla/fenix/dualscreen/BrowserReadAloudController.kt
new file mode 100644
index 0000000000000000000000000000000000000000..e7890cc3580351200708fb1a0dc22e0db8ce3113
--- /dev/null
+++ b/app/src/main/java/org/mozilla/fenix/dualscreen/BrowserReadAloudController.kt
@@ -0,0 +1,402 @@
+package org.mozilla.fenix.dualscreen
+
+import android.content.Context
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.speech.tts.TextToSpeech
+import android.speech.tts.UtteranceProgressListener
+import android.util.Log
+import java.text.Normalizer
+import java.util.Locale
+
+internal enum class BrowserTtsState {
+    IDLE,
+    LOADING,
+    SPEAKING,
+    PAUSED,
+}
+
+internal data class BrowserTtsUiState(
+    val state: BrowserTtsState,
+    val message: String,
+    val index: Int = 0,
+    val total: Int = 0,
+)
+
+/**
+ * Process-wide read-aloud state machine for the one shared GeckoSession.
+ *
+ * It intentionally owns both cloud engines and the Android fallback so the two
+ * display Activities can never create two competing players.
+ */
+internal class BrowserReadAloudController(
+    context: Context,
+    private val requestPageText: (Int) -> Unit,
+    private val followChunk: (String) -> Unit,
+    private val clearHighlight: () -> Unit,
+    private val onUiState: (BrowserTtsUiState) -> Unit,
+) {
+    private val appContext = context.applicationContext
+    private val mainHandler = Handler(Looper.getMainLooper())
+    private val iflytek = IflytekTtsEngine(appContext)
+    private val prefetcher = IflytekTtsEngine(appContext)
+    private val chunks = mutableListOf<String>()
+
+    private var localTts: TextToSpeech? = null
+    private var localReady = false
+    private var state = BrowserTtsState.IDLE
+    private var generation = 0
+    private var chunkIndex = 0
+    private var usingIflytek = false
+    private var prefetchedClip: IflytekTtsEngine.PcmClip? = null
+    private var prefetchIndex = -1
+    private var prefetching = false
+    private var waitingForPrefetch = false
+    private var lastUiState = BrowserTtsUiState(BrowserTtsState.IDLE, "朗读")
+
+    init {
+        localTts = TextToSpeech(appContext) { result ->
+            mainHandler.post {
+                localReady = result == TextToSpeech.SUCCESS
+                if (localReady) {
+                    val engine = localTts ?: return@post
+                    val languageResult = engine.setLanguage(Locale.SIMPLIFIED_CHINESE)
+                    if (languageResult == TextToSpeech.LANG_MISSING_DATA ||
+                        languageResult == TextToSpeech.LANG_NOT_SUPPORTED
+                    ) {
+                        engine.language = Locale.getDefault()
+                    }
+                    engine.setSpeechRate(1.0f)
+                    engine.setPitch(1.0f)
+                    engine.setOnUtteranceProgressListener(object : UtteranceProgressListener() {
+                        override fun onStart(utteranceId: String?) = Unit
+
+                        override fun onDone(utteranceId: String?) {
+                            val token = utteranceId?.substringAfter("kbrowser-")
+                                ?.substringBefore('-')?.toIntOrNull() ?: return
+                            mainHandler.post { advance(token) }
+                        }
+
+                        @Deprecated("Deprecated in Java")
+                        override fun onError(utteranceId: String?) {
+                            mainHandler.post { fail("系统朗读失败") }
+                        }
+                    })
+                }
+                Log.i(TAG, "TTS_LOCAL_READY ready=$localReady")
+            }
+        }
+    }
+
+    fun toggle() {
+        when (state) {
+            BrowserTtsState.IDLE -> start()
+            BrowserTtsState.LOADING -> stop("user-cancelled-loading")
+            BrowserTtsState.SPEAKING -> pause()
+            BrowserTtsState.PAUSED -> resume()
+        }
+    }
+
+    fun currentUiState(): BrowserTtsUiState = lastUiState
+
+    fun start() {
+        stopInternal(clearQueue = true)
+        val token = ++generation
+        state = BrowserTtsState.LOADING
+        emit("正在提取当前页面…")
+        Log.i(TAG, "TTS_EXTRACT_REQUEST generation=$token")
+        requestPageText(token)
+        mainHandler.postDelayed({
+            if (generation == token && state == BrowserTtsState.LOADING) {
+                fail("页面文字提取超时")
+            }
+        }, EXTRACTION_TIMEOUT_MS)
+    }
+
+    fun acceptPageText(requestGeneration: Int, text: String) {
+        if (requestGeneration != generation || state != BrowserTtsState.LOADING) {
+            Log.i(TAG, "Ignoring stale page extraction generation=$requestGeneration")
+            return
+        }
+        val sanitized = sanitizeForSpeech(text)
+        chunks.clear()
+        chunks += SpeechTextSegmenter.split(sanitized)
+        if (chunks.isEmpty()) {
+            fail("当前页面没有检测到可朗读文字")
+            return
+        }
+        chunkIndex = 0
+        val longest = chunks.maxOfOrNull { it.length } ?: 0
+        Log.i(
+            TAG,
+            "TTS_SEGMENTS policy=punctuation count=${chunks.size} " +
+                "firstChars=${chunks.first().length} maxChars=$longest",
+        )
+        speakCurrent(requestGeneration)
+    }
+
+    fun pause() {
+        if (state != BrowserTtsState.SPEAKING) return
+        // This firmware may report AudioTrack.play() after pause while staying
+        // silent. Stop the stream and deterministically rebuild this sentence.
+        generation++
+        iflytek.stop()
+        prefetcher.stop()
+        localTts?.stop()
+        resetPrefetch()
+        state = BrowserTtsState.PAUSED
+        emit("已暂停 · 第 ${chunkIndex + 1}/${chunks.size} 段")
+        Log.i(TAG, "TTS_PAUSE index=$chunkIndex")
+    }
+
+    fun resume() {
+        if (state != BrowserTtsState.PAUSED || chunks.isEmpty()) return
+        val token = ++generation
+        Log.i(TAG, "TTS_RESUME_RESTART_CHUNK index=$chunkIndex")
+        speakCurrent(token)
+    }
+
+    fun stop(reason: String) {
+        if (state == BrowserTtsState.IDLE && chunks.isEmpty()) return
+        generation++
+        stopInternal(clearQueue = true)
+        state = BrowserTtsState.IDLE
+        clearHighlight()
+        emit("朗读")
+        Log.i(TAG, "TTS_STOP reason=$reason")
+    }
+
+    fun shutdown() {
+        stop("session-shutdown")
+        localTts?.shutdown()
+        localTts = null
+        localReady = false
+    }
+
+    private fun speakCurrent(token: Int) {
+        if (token != generation) return
+        if (chunkIndex >= chunks.size) {
+            finishReading()
+            return
+        }
+        state = BrowserTtsState.SPEAKING
+        emit("正在朗读 · 第 ${chunkIndex + 1}/${chunks.size} 段")
+        val chunk = chunks[chunkIndex]
+        followChunk(chunk)
+        Log.i(TAG, "TTS_CHUNK_START index=$chunkIndex/${chunks.size} chars=${chunk.length}")
+        if (iflytek.hasSystemCredentials()) {
+            usingIflytek = true
+            prefetchNext(chunkIndex + 1, token)
+            iflytek.speak(chunk, object : IflytekTtsEngine.Listener {
+                override fun onStarted() = Unit
+
+                override fun onDone() {
+                    mainHandler.post { advance(token) }
+                }
+
+                override fun onError(message: String) {
+                    mainHandler.post {
+                        if (token == generation) speakWithLocalFallback(token, message)
+                    }
+                }
+            })
+        } else {
+            speakWithLocalFallback(token, null)
+        }
+    }
+
+    private fun prefetchNext(targetIndex: Int, token: Int) {
+        if (targetIndex >= chunks.size || token != generation) return
+        prefetchIndex = targetIndex
+        prefetchedClip = null
+        prefetching = true
+        Log.i(TAG, "TTS_PREFETCH_SUBMITTED index=$targetIndex")
+        prefetcher.synthesize(chunks[targetIndex], object : IflytekTtsEngine.SynthesisListener {
+            override fun onBuffering() = Unit
+
+            override fun onReady(clip: IflytekTtsEngine.PcmClip) {
+                mainHandler.post {
+                    if (token != generation || prefetchIndex != targetIndex) return@post
+                    prefetchedClip = clip
+                    prefetching = false
+                    Log.i(TAG, "TTS_PREFETCH_READY index=$targetIndex")
+                    if (waitingForPrefetch && state == BrowserTtsState.SPEAKING &&
+                        chunkIndex == targetIndex
+                    ) {
+                        playPrefetched(token)
+                    }
+                }
+            }
+
+            override fun onError(message: String) {
+                mainHandler.post {
+                    if (token != generation || prefetchIndex != targetIndex) return@post
+                    prefetching = false
+                    prefetchedClip = null
+                    if (waitingForPrefetch && chunkIndex == targetIndex) {
+                        waitingForPrefetch = false
+                        speakCurrent(token)
+                    }
+                }
+            }
+        })
+    }
+
+    private fun playPrefetched(token: Int) {
+        val clip = prefetchedClip ?: run {
+            speakCurrent(token)
+            return
+        }
+        prefetchedClip = null
+        waitingForPrefetch = false
+        state = BrowserTtsState.SPEAKING
+        usingIflytek = true
+        emit("正在朗读 · 第 ${chunkIndex + 1}/${chunks.size} 段")
+        followChunk(chunks[chunkIndex])
+        Log.i(TAG, "TTS_PREFETCH_PLAY index=$chunkIndex/${chunks.size}")
+        iflytek.play(clip, object : IflytekTtsEngine.Listener {
+            override fun onStarted() {
+                mainHandler.post { prefetchNext(chunkIndex + 1, token) }
+            }
+
+            override fun onDone() {
+                mainHandler.post { advance(token) }
+            }
+
+            override fun onError(message: String) {
+                mainHandler.post {
+                    if (token == generation) speakWithLocalFallback(token, message)
+                }
+            }
+        })
+    }
+
+    private fun advance(token: Int) {
+        if (token != generation || state != BrowserTtsState.SPEAKING) return
+        Log.i(TAG, "TTS_CHUNK_DONE index=$chunkIndex/${chunks.size}")
+        chunkIndex++
+        if (chunkIndex >= chunks.size) {
+            finishReading()
+            return
+        }
+        if (prefetchedClip != null && prefetchIndex == chunkIndex) {
+            playPrefetched(token)
+        } else if (prefetching && prefetchIndex == chunkIndex) {
+            waitingForPrefetch = true
+            emit("正在缓冲 · 第 ${chunkIndex + 1}/${chunks.size} 段")
+        } else {
+            speakCurrent(token)
+        }
+    }
+
+    private fun speakWithLocalFallback(token: Int, cloudError: String?) {
+        if (token != generation) return
+        prefetcher.stop()
+        resetPrefetch()
+        usingIflytek = false
+        val engine = localTts
+        if (!localReady || engine == null) {
+            fail(cloudError ?: "系统朗读引擎不可用")
+            return
+        }
+        if (cloudError != null) Log.w(TAG, "Cloud TTS unavailable; using Android TTS: $cloudError")
+        val options = Bundle()
+        val result = engine.speak(
+            chunks[chunkIndex],
+            TextToSpeech.QUEUE_FLUSH,
+            options,
+            "kbrowser-$token-$chunkIndex",
+        )
+        if (result == TextToSpeech.ERROR) fail("系统朗读启动失败")
+    }
+
+    private fun finishReading() {
+        val total = chunks.size
+        Log.i(TAG, "TTS_COMPLETE chunks=$total")
+        generation++
+        stopInternal(clearQueue = true)
+        state = BrowserTtsState.IDLE
+        clearHighlight()
+        emit("朗读完成")
+        mainHandler.postDelayed({
+            if (state == BrowserTtsState.IDLE) emit("朗读")
+        }, 1_500L)
+    }
+
+    private fun fail(message: String) {
+        Log.w(TAG, "TTS_ERROR $message")
+        generation++
+        stopInternal(clearQueue = true)
+        state = BrowserTtsState.IDLE
+        clearHighlight()
+        lastUiState = BrowserTtsUiState(BrowserTtsState.IDLE, message)
+        onUiState(lastUiState)
+    }
+
+    private fun stopInternal(clearQueue: Boolean) {
+        iflytek.stop()
+        prefetcher.stop()
+        localTts?.stop()
+        resetPrefetch()
+        usingIflytek = false
+        if (clearQueue) {
+            chunks.clear()
+            chunkIndex = 0
+        }
+    }
+
+    private fun resetPrefetch() {
+        prefetchedClip = null
+        prefetchIndex = -1
+        prefetching = false
+        waitingForPrefetch = false
+    }
+
+    private fun emit(message: String) {
+        lastUiState = BrowserTtsUiState(state, message, chunkIndex, chunks.size)
+        onUiState(lastUiState)
+    }
+
+    private fun sanitizeForSpeech(raw: String): String {
+        val normalized = Normalizer.normalize(raw, Normalizer.Form.NFKC)
+        val result = StringBuilder(normalized.length.coerceAtMost(MAX_TEXT_CHARS))
+        var offset = 0
+        var previousSpace = false
+        var consecutiveNewlines = 0
+        while (offset < normalized.length && result.length < MAX_TEXT_CHARS) {
+            val codePoint = normalized.codePointAt(offset)
+            offset += Character.charCount(codePoint)
+            val type = Character.getType(codePoint)
+            if (type == Character.CONTROL.toInt() && codePoint != '\n'.code && codePoint != '\r'.code &&
+                codePoint != '\t'.code
+            ) continue
+            if (type == Character.FORMAT.toInt() || type == Character.PRIVATE_USE.toInt() ||
+                type == Character.UNASSIGNED.toInt()
+            ) continue
+            when (codePoint) {
+                '\r'.code, '\n'.code -> {
+                    if (consecutiveNewlines < 2 && result.isNotEmpty()) result.append('\n')
+                    consecutiveNewlines++
+                    previousSpace = false
+                }
+                '\t'.code, ' '.code -> {
+                    if (!previousSpace && result.isNotEmpty()) result.append(' ')
+                    previousSpace = true
+                }
+                else -> {
+                    result.appendCodePoint(codePoint)
+                    previousSpace = false
+                    consecutiveNewlines = 0
+                }
+            }
+        }
+        return result.toString().trim()
+    }
+
+    companion object {
+        private const val TAG = "KBrowserTts"
+        private const val MAX_TEXT_CHARS = 500_000
+        private const val EXTRACTION_TIMEOUT_MS = 8_000L
+    }
+}
diff --git a/app/src/main/java/org/mozilla/fenix/dualscreen/BrowserTtsBridge.kt b/app/src/main/java/org/mozilla/fenix/dualscreen/BrowserTtsBridge.kt
new file mode 100644
index 0000000000000000000000000000000000000000..094c496ae7fc0e2666d29b97e12ed99a4d61be9e
--- /dev/null
+++ b/app/src/main/java/org/mozilla/fenix/dualscreen/BrowserTtsBridge.kt
@@ -0,0 +1,106 @@
+package org.mozilla.fenix.dualscreen
+
+import android.util.Log
+import org.json.JSONObject
+import org.mozilla.geckoview.GeckoRuntime
+import org.mozilla.geckoview.GeckoSession
+import org.mozilla.geckoview.WebExtension
+
+/** Native-messaging bridge used only to read and follow the currently visible web document. */
+internal class BrowserTtsBridge(
+    private val runtime: GeckoRuntime,
+    private val session: GeckoSession,
+    private val onPageText: (Int, String) -> Unit,
+) {
+    private var extension: WebExtension? = null
+    private var port: WebExtension.Port? = null
+
+    fun install() {
+        runtime.webExtensionController.ensureBuiltIn(EXTENSION_URL, EXTENSION_ID).accept(
+            { installed ->
+                if (installed == null) {
+                    Log.w(TAG, "TTS content extension install returned null")
+                    return@accept
+                }
+                extension = installed
+                session.webExtensionController.setMessageDelegate(
+                    installed,
+                    object : WebExtension.MessageDelegate {
+                        override fun onConnect(connectedPort: WebExtension.Port) {
+                            if (connectedPort.sender.session !== session) {
+                                connectedPort.disconnect()
+                                return
+                            }
+                            port?.disconnect()
+                            port = connectedPort
+                            connectedPort.setDelegate(object : WebExtension.PortDelegate {
+                                override fun onPortMessage(
+                                    message: Any,
+                                    sourcePort: WebExtension.Port,
+                                ) {
+                                    handleMessage(message)
+                                }
+
+                                override fun onDisconnect(sourcePort: WebExtension.Port) {
+                                    if (port === sourcePort) port = null
+                                }
+                            })
+                            Log.i(TAG, "TTS_CONTENT_BRIDGE_CONNECTED")
+                        }
+                    },
+                    NATIVE_APP,
+                )
+                Log.i(TAG, "TTS_CONTENT_EXTENSION_READY")
+            },
+            { error -> Log.w(TAG, "TTS content extension install failed", error) },
+        )
+    }
+
+    fun requestPageText(requestId: Int): Boolean {
+        val connected = port ?: return false
+        connected.postMessage(
+            JSONObject()
+                .put("type", "extract")
+                .put("requestId", requestId),
+        )
+        return true
+    }
+
+    fun followChunk(text: String) {
+        port?.postMessage(
+            JSONObject()
+                .put("type", "follow")
+                .put("text", text.take(160)),
+        )
+    }
+
+    fun clearHighlight() {
+        port?.postMessage(JSONObject().put("type", "clear"))
+    }
+
+    fun shutdown() {
+        port?.disconnect()
+        port = null
+        extension = null
+    }
+
+    private fun handleMessage(message: Any) {
+        val packet = when (message) {
+            is JSONObject -> message
+            is String -> runCatching { JSONObject(message) }.getOrNull()
+            else -> null
+        } ?: return
+        if (packet.optString("type") != "pageText") return
+        val requestId = packet.optInt("requestId", -1)
+        val text = packet.optString("text")
+        Log.i(TAG, "TTS_PAGE_TEXT chars=${text.length} request=$requestId")
+        onPageText(requestId, text)
+    }
+
+    companion object {
+        private const val TAG = "KBrowserTts"
+        private const val EXTENSION_URL = "resource://android/assets/kbrowser_tts/"
+        private const val EXTENSION_ID = "kbrowser-tts@kemi.local"
+        private const val NATIVE_APP = "kbrowser_tts"
+    }
+}
