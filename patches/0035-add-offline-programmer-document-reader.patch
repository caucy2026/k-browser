+    /**
+     * Loopback-only origin for generated pages. A normal HTTP origin lets the existing read-aloud
+     * WebExtension locate the first visible line, highlight it and auto-scroll; data: URLs do not.
+     */
+    private class LocalDocumentServer(private val root: File) {
+        private val socket = ServerSocket(0, 16, InetAddress.getByName("127.0.0.1"))
+
+        init {
+            thread(name = "KBrowserDocumentServer", isDaemon = true) {
+                while (!socket.isClosed) {
+                    runCatching { socket.accept() }.getOrNull()?.let { client ->
+                        runCatching {
+                            client.use {
+                                val reader = it.getInputStream().bufferedReader(Charsets.US_ASCII)
+                                val request = reader.readLine().orEmpty().split(' ')
+                                var header = reader.readLine()
+                                while (!header.isNullOrEmpty()) header = reader.readLine()
+                                val name = request.getOrNull(1)?.substringAfterLast('/')
+                                    ?.substringBefore('?').orEmpty()
+                                val file = File(root, name).canonicalFile
+                                val valid = request.firstOrNull() == "GET" &&
+                                    name.matches(Regex("[0-9a-f]{24}\\.html")) &&
+                                    file.path.startsWith(root.path + File.separator) && file.isFile &&
+                                    file.length() <= MAX_HTML_CHARS
+                                val body = if (valid) file.readBytes() else "Not found".toByteArray()
+                                val status = if (valid) "200 OK" else "404 Not Found"
+                                val output = it.getOutputStream()
+                                output.write(
+                                    ("HTTP/1.1 $status\r\n" +
+                                        "Content-Type: text/html; charset=utf-8\r\n" +
+                                        "Content-Length: ${body.size}\r\n" +
+                                        "Cache-Control: no-store\r\nConnection: close\r\n\r\n")
+                                        .toByteArray(Charsets.US_ASCII),
+                                )
+                                output.write(body)
+                                output.flush()
+                            }
+                        }.onFailure {
+                            // Gecko may close a no-store response as the paired Activity exits.
+                            // That expected disconnect is not a document/server failure.
+                            if (it !is java.net.SocketException) {
+                                Log.w(TAG, "Loopback document response failed", it)
+                            }
+                        }
+                    }
+                }
+            }
+            Log.i(TAG, "DOCUMENT_SERVER_READY loopback=true port=${socket.localPort}")
+        }
+
+        fun url(file: File): String = "http://127.0.0.1:${socket.localPort}/kbrowser-doc/${file.name}"
+    }
