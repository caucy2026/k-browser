+    private fun sanitizePlainBook(bytes: ByteArray): String = decodeText(bytes)
+        .replace(Regex("(?is)<script.*?</script>"), " ")
+        .replace(Regex("(?s)<[^>]+>"), "\n")
+
+    private fun legacyOffice(bytes: ByteArray, format: String): String {
+        val strings = ArrayList<String>()
+        extractAsciiRuns(bytes, strings)
+        if (bytes.size >= OLE_MAGIC.size && bytes.copyOfRange(0, OLE_MAGIC.size).contentEquals(OLE_MAGIC)) {
+            extractUtf16LeRuns(bytes, strings)
+        }
+        val text = strings.asSequence().take(20_000).joinToString("\n")
+        return "<p class=warning>旧版 $format 为兼容提取视图，复杂布局、公式和宏不会执行或还原。建议另存为现代格式。</p>" +
+            paragraphs(text.ifBlank { "没有发现可读取的正文。" })
+    }
+
+    private fun extractAsciiRuns(bytes: ByteArray, output: MutableList<String>) {
+        val current = StringBuilder()
+        fun flush() {
+            if (current.length >= 4) output.add(current.toString())
+            current.setLength(0)
+        }
+        for (byte in bytes) {
+            val value = byte.toInt() and 0xff
+            if (value in 0x20..0x7e) current.append(value.toChar()) else flush()
+            if (output.size >= 20_000) return
+        }
+        flush()
+    }
+
+    private fun extractUtf16LeRuns(bytes: ByteArray, output: MutableList<String>) {
+        val current = StringBuilder()
+        var hasLetterOrDigit = false
+        fun flush() {
+            if (current.length >= 4 && hasLetterOrDigit) output.add(current.toString())
+            current.setLength(0)
+            hasLetterOrDigit = false
+        }
+        // OLE compound streams and their UTF-16LE strings are two-byte aligned. Scanning the odd
+        // alignment as well turns adjacent Chinese code units into plausible but meaningless CJK
+        // characters, doubles work and pollutes the compatibility view.
+        var index = 0
+        while (index + 1 < bytes.size && output.size < 20_000) {
+            val code = (bytes[index].toInt() and 0xff) or ((bytes[index + 1].toInt() and 0xff) shl 8)
+            val char = code.toChar()
+            if (char >= ' ' && !char.isISOControl() && char != '\uFFFD') {
+                current.append(char)
+                if (char.isLetterOrDigit()) hasLetterOrDigit = true
+            } else {
+                flush()
+            }
+            index += 2
+        }
+        flush()
+    }
