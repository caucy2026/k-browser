+/** Offline, bounded conversion of documents to semantic HTML for the shared Gecko canvas. */
+internal object DocumentReader {
+    const val EXTRA_CACHE_PATH = "kbrowser.document.cachePath"
+    const val EXTRA_TITLE = "kbrowser.document.title"
+    const val EXTRA_FORMAT = "kbrowser.document.format"
+    const val EXTRA_PARSE_MS = "kbrowser.document.parseMs"
+
+    private const val TAG = "KBrowserDocument"
+    private const val MAX_INPUT_BYTES = 32 * 1024 * 1024
+    private const val MAX_ZIP_ENTRY_BYTES = 16 * 1024 * 1024
+    private const val MAX_ZIP_TOTAL_BYTES = 64 * 1024 * 1024
+    private const val MAX_ZIP_ENTRIES = 2_048
+    private const val MAX_TEXT_CHARS = 500_000
+    private const val MAX_HTML_CHARS = 16 * 1024 * 1024
+    private const val MAX_TABLE_ROWS = 5_000
+    private const val MAX_TABLE_COLUMNS = 128
+    @Volatile private var documentServer: LocalDocumentServer? = null
+
+    data class Prepared(
+        val cachePath: String,
+        val title: String,
+        val format: String,
+        val parseMs: Long,
+    )
+
+    fun preparedUrl(context: Context, path: String?): String? {
+        if (path.isNullOrBlank()) return null
+        val root = File(context.cacheDir, "kbrowser-documents").canonicalFile
+        val file = File(path).canonicalFile
+        if (!file.path.startsWith(root.path + File.separator) || !file.isFile || file.length() > MAX_HTML_CHARS) {
+            Log.w(TAG, "Rejected invalid prepared document path")
+            return null
+        }
+        val server = runCatching {
+            documentServer ?: synchronized(this) {
+                documentServer ?: LocalDocumentServer(root).also { documentServer = it }
+            }
+        }.getOrElse {
+            Log.e(TAG, "Unable to start loopback document server", it)
+            return null
+        }
+        return server.url(file)
+    }
+
+    fun isLocalDocument(intent: Intent): Boolean {
+        if (intent.action != Intent.ACTION_VIEW) return false
+        val uri = intent.data ?: return false
+        return uri.scheme == "content" || uri.scheme == "file"
+    }
+
+    fun prepare(context: Context, intent: Intent): Prepared {
+        val started = System.nanoTime()
+        val uri = requireNotNull(intent.data)
+        val title = displayName(context, uri).ifBlank { "未命名文档" }
+        val extension = title.substringAfterLast('.', "").lowercase(Locale.ROOT)
+        val mime = intent.type.orEmpty().lowercase(Locale.ROOT)
+        val readResult = runCatching { readBounded(context, uri) }
+        val bytes = readResult.getOrDefault(byteArrayOf())
+        val format = detectFormat(extension, mime, bytes)
+        val body = readResult.fold(
+            onSuccess = { runCatching { convert(format, title, it) }.getOrElse { error ->
+                Log.w(TAG, "parse failed format=$format bytes=${it.size}: ${error.javaClass.simpleName}")
+                errorBody(title, format, error.message ?: "文档结构损坏或暂不兼容")
+            } },
+            onFailure = { error ->
+                Log.w(TAG, "read failed format=$format: ${error.javaClass.simpleName}")
+                errorBody(title, format, error.message ?: "无法读取文档")
+            },
+        )
+        val html = page(title, format, bytes.size, body).take(MAX_HTML_CHARS)
+        val digest = MessageDigest.getInstance("SHA-256")
+            .digest((uri.toString() + bytes.size + format).toByteArray())
+            .take(12).joinToString("") { "%02x".format(it) }
+        val directory = File(context.cacheDir, "kbrowser-documents").apply { mkdirs() }
+        prune(directory)
+        val output = File(directory, "$digest.html")
+        output.writeText(html, Charsets.UTF_8)
+        val elapsedMs = (System.nanoTime() - started) / 1_000_000
+        Log.i(
+            TAG,
+            "DOCUMENT_READY format=$format bytes=${bytes.size} chars=${html.length} parseMs=$elapsedMs",
+        )
+        return Prepared(output.absolutePath, title, format, elapsedMs)
+    }
+
+    private fun readBounded(context: Context, uri: Uri): ByteArray {
+        val stream = context.contentResolver.openInputStream(uri)
+            ?: error("无法读取文档")
+        stream.use { input ->
+            val output = ByteArrayOutputStream()
+            val buffer = ByteArray(32 * 1024)
+            var total = 0
+            while (true) {
+                val count = input.read(buffer)
+                if (count < 0) break
+                total += count
+                require(total <= MAX_INPUT_BYTES) { "文档超过 32 MiB 安全上限" }
+                output.write(buffer, 0, count)
+            }
+            return output.toByteArray()
+        }
+    }
+
+    private fun displayName(context: Context, uri: Uri): String {
+        if (uri.scheme == "file") return uri.lastPathSegment.orEmpty()
+        var cursor: Cursor? = null
+        return try {
+            cursor = context.contentResolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)
+            if (cursor?.moveToFirst() == true) cursor.getString(0).orEmpty() else uri.lastPathSegment.orEmpty()
+        } catch (_: Exception) {
+            uri.lastPathSegment.orEmpty()
+        } finally {
+            cursor?.close()
+        }
+    }
+
+    private fun detectFormat(extension: String, mime: String, bytes: ByteArray): String {
+        if (extension.isNotEmpty()) return extension
+        if (bytes.size >= 4 && bytes[0] == 'P'.code.toByte() && bytes[1] == 'K'.code.toByte()) {
+            return when {
+                mime.contains("wordprocessing") -> "docx"
+                mime.contains("spreadsheet") -> "xlsx"
+                mime.contains("presentation") -> "pptx"
+                mime.contains("epub") -> "epub"
+                else -> "zip-document"
+            }
+        }
+        return when {
+            mime.contains("json") -> "json"
+            mime.contains("xml") -> "xml"
+            mime.contains("csv") -> "csv"
+            mime.contains("rtf") -> "rtf"
+            mime.startsWith("text/") -> "txt"
+            else -> "bin"
+        }
+    }
+
+    private fun convert(format: String, title: String, bytes: ByteArray): String = when (format) {
+        "html", "htm", "xhtml" -> sanitizeHtml(decodeText(bytes))
+        "md", "markdown" -> markdown(decodeText(bytes))
+        "json", "geojson", "ipynb" -> codeBlock(prettyJson(decodeText(bytes)), "JSON")
+        "xml", "svg" -> codeBlock(decodeText(bytes), "XML")
+        "csv" -> delimited(decodeText(bytes), ',')
+        "tsv" -> delimited(decodeText(bytes), '\t')
+        "docx" -> docx(unzip(bytes))
+        "xlsx" -> xlsx(unzip(bytes))
+        "pptx" -> pptx(unzip(bytes))
+        "odt", "ods", "odp" -> odf(unzip(bytes), format)
+        "epub" -> epub(unzip(bytes))
+        "rtf" -> paragraphs(rtf(decodeText(bytes)))
+        "mobi", "azw", "azw3" -> paragraphs(mobi(bytes))
+        "doc", "xls", "ppt" -> legacyOffice(bytes, format)
+        "zip-document" -> errorBody(title, format, "无法从 MIME 判断 ZIP 文档类型")
+        in sourceFormats -> codeBlock(decodeText(bytes), format.uppercase(Locale.ROOT))
+        else -> paragraphs(decodeText(bytes))
+    }
+
+    private fun decodeText(bytes: ByteArray): String {
+        val content = when {
+            bytes.size >= 3 && bytes[0] == 0xef.toByte() && bytes[1] == 0xbb.toByte() && bytes[2] == 0xbf.toByte() ->
+                bytes.copyOfRange(3, bytes.size).toString(Charsets.UTF_8)
+            bytes.size >= 2 && bytes[0] == 0xff.toByte() && bytes[1] == 0xfe.toByte() ->
+                bytes.copyOfRange(2, bytes.size).toString(Charsets.UTF_16LE)
+            bytes.size >= 2 && bytes[0] == 0xfe.toByte() && bytes[1] == 0xff.toByte() ->
+                bytes.copyOfRange(2, bytes.size).toString(Charsets.UTF_16BE)
+            else -> bytes.toString(Charsets.UTF_8)
+        }
+        val replacementRatio = content.count { it == '\uFFFD' }.toDouble() / content.length.coerceAtLeast(1)
+        return if (replacementRatio > 0.01) bytes.toString(Charset.forName("GB18030")) else content
+    }
+
+    private fun prettyJson(text: String): String = try {
+        when (val value = JSONTokener(text).nextValue()) {
+            is JSONObject -> value.toString(2)
+            is JSONArray -> value.toString(2)
+            else -> text
+        }
+    } catch (_: Exception) {
+        text
+    }
+
+    private fun markdown(text: String): String {
+        val output = StringBuilder()
+        var inCode = false
+        for (raw in text.lineSequence().take(20_000)) {
+            val line = raw.trimEnd()
+            if (line.trimStart().startsWith("```")) {
+                output.append(if (inCode) "</code></pre>" else "<pre><code>")
+                inCode = !inCode
+                continue
+            }
+            if (inCode) {
+                output.append(escape(line)).append('\n')
+                continue
+            }
+            val heading = line.takeWhile { it == '#' }.length
+            val trimmedStart = line.trimStart()
+            when {
+                heading in 1..6 && line.getOrNull(heading) == ' ' ->
+                    output.append("<h$heading>").append(inlineMarkdown(line.drop(heading + 1))).append("</h$heading>")
+                trimmedStart.length >= 2 && trimmedStart[0] in "-*+" && trimmedStart[1].isWhitespace() ->
+                    output.append("<p class=bullet>• ").append(inlineMarkdown(trimmedStart.drop(2).trimStart())).append("</p>")
+                isNumberedMarkdownLine(trimmedStart) ->
+                    output.append("<p>").append(inlineMarkdown(line.trim())).append("</p>")
+                line.isBlank() -> output.append("<div class=gap></div>")
+                else -> output.append("<p>").append(inlineMarkdown(line)).append("</p>")
+            }
+        }
+        if (inCode) output.append("</code></pre>")
+        return output.toString()
+    }
+
+    private fun isNumberedMarkdownLine(text: String): Boolean {
+        var index = 0
+        while (index < text.length && text[index].isDigit()) index++
+        return index > 0 && index + 1 < text.length && text[index] in ".)" && text[index + 1].isWhitespace()
+    }
+
+    private fun inlineMarkdown(text: String): String {
+        val escaped = escape(text)
+        if ('`' !in escaped && "**" !in escaped) return escaped
+        return escaped
+            .replace(INLINE_CODE_REGEX, "<code>$1</code>")
+            .replace(INLINE_STRONG_REGEX, "<strong>$1</strong>")
+    }
+
+    private fun delimited(text: String, delimiter: Char): String {
+        val rows = parseDelimited(text, delimiter)
+        if (rows.isEmpty()) return "<p>空表格</p>"
+        val output = StringBuilder("<div class=table-wrap><table>")
+        rows.take(MAX_TABLE_ROWS).forEachIndexed { rowIndex, row ->
+            output.append("<tr>")
+            row.take(MAX_TABLE_COLUMNS).forEach { cell ->
+                val tag = if (rowIndex == 0) "th" else "td"
+                output.append("<$tag>").append(escape(cell)).append("</$tag>")
+            }
+            output.append("</tr>")
+        }
+        output.append("</table></div>")
+        if (rows.size > MAX_TABLE_ROWS) output.append("<p class=warning>表格已按安全上限截断。</p>")
+        return output.toString()
+    }
+
+    private fun parseDelimited(text: String, delimiter: Char): List<List<String>> {
+        val rows = mutableListOf<MutableList<String>>()
+        var row = mutableListOf<String>()
+        val cell = StringBuilder()
+        var quoted = false
+        var index = 0
+        while (index < text.length && rows.size < MAX_TABLE_ROWS + 1) {
+            val char = text[index]
+            when {
+                char == '"' && quoted && text.getOrNull(index + 1) == '"' -> { cell.append('"'); index++ }
+                char == '"' -> quoted = !quoted
+                char == delimiter && !quoted -> { row.add(cell.toString()); cell.setLength(0) }
+                (char == '\n' || char == '\r') && !quoted -> {
+                    if (char == '\r' && text.getOrNull(index + 1) == '\n') index++
+                    row.add(cell.toString()); cell.setLength(0); rows.add(row); row = mutableListOf()
+                }
+                else -> cell.append(char)
+            }
+            index++
+        }
+        if (cell.isNotEmpty() || row.isNotEmpty()) { row.add(cell.toString()); rows.add(row) }
+        return rows
+    }
