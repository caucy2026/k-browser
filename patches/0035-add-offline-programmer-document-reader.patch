+    private fun rtf(input: String): String {
+        val output = StringBuilder()
+        var index = 0
+        var skipGroupDepth = 0
+        var depth = 0
+        while (index < input.length && output.length < MAX_TEXT_CHARS) {
+            when (val char = input[index]) {
+                '{' -> depth++
+                '}' -> { if (skipGroupDepth == depth) skipGroupDepth = 0; depth-- }
+                '\\' -> {
+                    if (input.getOrNull(index + 1) == '*') { skipGroupDepth = depth; index++ }
+                    else if (input.getOrNull(index + 1) == '\\' || input.getOrNull(index + 1) == '{' || input.getOrNull(index + 1) == '}') {
+                        if (skipGroupDepth == 0) output.append(input[index + 1]); index++
+                    } else if (input.getOrNull(index + 1) == '\'') {
+                        val hex = input.substring(index + 2, (index + 4).coerceAtMost(input.length))
+                        if (skipGroupDepth == 0) output.append(hex.toIntOrNull(16)?.toChar() ?: ' ')
+                        index += 3
+                    } else {
+                        val match = Regex("^\\\\([a-zA-Z]+)(-?\\d+)? ?").find(input.substring(index))
+                        if (match != null) {
+                            val word = match.groupValues[1]
+                            val number = match.groupValues[2].toIntOrNull()
+                            if (skipGroupDepth == 0) when (word) {
+                                "par", "line" -> output.append('\n')
+                                "tab" -> output.append('\t')
+                                "u" -> number?.let { output.append((it and 0xffff).toChar()) }
+                            }
+                            index += match.value.length - 1
+                        }
+                    }
+                }
+                else -> if (skipGroupDepth == 0 && char.code >= 32) output.append(char)
+            }
+            index++
+        }
+        return output.toString()
+    }
