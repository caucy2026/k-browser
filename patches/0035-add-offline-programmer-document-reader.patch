+    private fun xmlSemantic(xml: String, paragraphTags: Set<String>, breakTags: Set<String>): String {
+        var value = xml
+        breakTags.forEach { tag -> value = value.replace(Regex("(?is)<(?:\\w+:)?$tag\\b[^>]*/?>"), "\t") }
+        paragraphTags.forEach { tag -> value = value.replace(Regex("(?is)</(?:\\w+:)?$tag\\s*>"), "\n") }
+        value = value.replace(Regex("(?is)<[^>]+>"), "")
+        return paragraphs(xmlDecode(value))
+    }
+
+    private fun tagTexts(xml: String, localName: String): List<String> =
+        Regex("(?is)<(?:\\w+:)?$localName\\b[^>]*>(.*?)</(?:\\w+:)?$localName>")
+            .findAll(xml).map { it.groupValues[1].replace(Regex("(?s)<[^>]+>"), "") }.toList()
+
+    private fun sanitizeHtml(input: String): String {
+        val withoutDanger = input
+            .replace(Regex("(?is)<script\\b.*?</script>"), "")
+            .replace(Regex("(?is)<iframe\\b.*?</iframe>"), "")
+            .replace(Regex("(?is)<object\\b.*?</object>"), "")
+            .replace(Regex("(?is)<embed\\b[^>]*>"), "")
+            .replace(Regex("(?i)\\son[a-z]+\\s*=\\s*([\"']).*?\\1"), "")
+        val body = Regex("(?is)<body\\b[^>]*>(.*?)</body>").find(withoutDanger)?.groupValues?.get(1)
+            ?: withoutDanger
+        return body.take(MAX_HTML_CHARS / 2)
+    }
