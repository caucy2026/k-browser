+    private fun mobi(bytes: ByteArray): String {
+        require(bytes.size >= 86) { "MOBI 文件过短" }
+        fun u16(offset: Int) = ByteBuffer.wrap(bytes, offset, 2).order(ByteOrder.BIG_ENDIAN).short.toInt() and 0xffff
+        fun u32(offset: Int) = ByteBuffer.wrap(bytes, offset, 4).order(ByteOrder.BIG_ENDIAN).int
+        val records = u16(76)
+        require(records in 1..10_000) { "MOBI 记录表损坏" }
+        val offsets = (0 until records).map { u32(78 + it * 8) }.filter { it in 0 until bytes.size }
+        require(offsets.isNotEmpty()) { "MOBI 没有正文记录" }
+        val record0 = bytes.copyOfRange(offsets[0], offsets.getOrElse(1) { bytes.size })
+        val compression = ByteBuffer.wrap(record0, 0, 2).order(ByteOrder.BIG_ENDIAN).short.toInt() and 0xffff
+        val textLength = ByteBuffer.wrap(record0, 4, 4).order(ByteOrder.BIG_ENDIAN).int
+        val textRecords = ByteBuffer.wrap(record0, 8, 2).order(ByteOrder.BIG_ENDIAN).short.toInt() and 0xffff
+        val encryption = ByteBuffer.wrap(record0, 12, 2).order(ByteOrder.BIG_ENDIAN).short.toInt() and 0xffff
+        require(encryption == 0) { "加密/DRM MOBI 不支持" }
+        require(compression == 1 || compression == 2) { "不支持的 MOBI 压缩方式 $compression" }
+        val output = ByteArrayOutputStream()
+        val targetBytes = textLength.coerceIn(0, MAX_TEXT_CHARS * 4)
+        for (index in 1..textRecords.coerceAtMost(offsets.size - 1)) {
+            val end = offsets.getOrElse(index + 1) { bytes.size }
+            val record = bytes.copyOfRange(offsets[index], end)
+            val decoded = if (compression == 2) decompressPalmDoc(record) else record
+            val remaining = targetBytes - output.size()
+            if (remaining <= 0) break
+            output.write(decoded, 0, decoded.size.coerceAtMost(remaining))
+        }
+        return sanitizePlainBook(output.toByteArray())
+    }
+
+    private fun decompressPalmDoc(input: ByteArray): ByteArray {
+        // PalmDOC back-references are allowed to overlap the bytes currently being produced.
+        // A fixed incremental buffer handles that in O(n), unlike rebuilding a full snapshot for
+        // every pair, and bounds a hostile book's temporary memory on the target vehicle.
+        val output = ByteArray(MAX_TEXT_CHARS * 4)
+        var outputSize = 0
+        fun append(value: Int) {
+            if (outputSize < output.size) output[outputSize++] = value.toByte()
+        }
+        var index = 0
+        while (index < input.size && outputSize < output.size) {
+            val value = input[index].toInt() and 0xff
+            index++
+            when {
+                value == 0 -> append(0)
+                value in 1..8 -> repeat(value.coerceAtMost(input.size - index)) { append(input[index++].toInt()) }
+                value <= 0x7f -> append(value)
+                value >= 0xc0 -> { append(' '.code); append(value xor 0x80) }
+                index < input.size -> {
+                    val pair = (value shl 8) or (input[index++].toInt() and 0xff)
+                    val distance = (pair shr 3) and 0x7ff
+                    val length = (pair and 7) + 3
+                    repeat(length) {
+                        val source = outputSize - distance
+                        append(if (source in 0 until outputSize) output[source].toInt() else ' '.code)
+                    }
+                }
+            }
+        }
+        return output.copyOf(outputSize)
+    }
