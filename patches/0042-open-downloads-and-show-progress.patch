+package org.mozilla.fenix.dualscreen
+
+import android.content.ContentValues
+import android.content.Context
+import android.net.Uri
+import android.os.Build
+import android.os.Environment
+import android.provider.MediaStore
+import android.util.Log
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import java.io.FileOutputStream
+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.concurrent.Executors
+import java.util.concurrent.CountDownLatch
+
+/** App-owned transfers provide a real Range-based pause/resume, which DownloadManager does not expose. */
+internal object BrowserDownloads {
+    const val RUNNING = 1
+    const val PAUSED = 2
+    const val COMPLETE = 3
+    const val FAILED = 4
+
+    data class Item(
+        val id: Long,
+        val url: String,
+        val title: String,
+        val mime: String,
+        val referer: String,
+        val status: Int,
+        val bytes: Long,
+        val total: Long,
+        val etag: String,
+        val uri: String,
+        val modified: Long,
+    )
+
+    private val lock = Any()
+    private val pool = Executors.newCachedThreadPool()
+    private val items = linkedMapOf<Long, Item>()
+    private val active = mutableMapOf<Long, Transfer>()
+    private lateinit var app: Context
+
+    private class Transfer {
+        @Volatile var stopped = false
+        @Volatile var connection: HttpURLConnection? = null
+        val done = CountDownLatch(1)
+        fun stop() {
+            stopped = true
+            connection?.disconnect()
+        }
+    }
+
+    private fun initialize(context: Context) = synchronized(lock) {
+        if (::app.isInitialized) return@synchronized
+        app = context.applicationContext
+        val saved = app.getSharedPreferences("kbrowser_downloads", Context.MODE_PRIVATE)
+            .getString("items", "[]").orEmpty()
+        runCatching {
+            val array = JSONArray(saved)
+            for (index in 0 until array.length()) {
+                val row = array.getJSONObject(index)
+                val item = Item(
+                    row.getLong("id"), row.getString("url"), row.getString("title"),
+                    row.optString("mime"), row.optString("referer"),
+                    row.getInt("status").let { if (it == RUNNING) PAUSED else it },
+                    row.optLong("bytes"), row.optLong("total", -1), row.optString("etag"),
+                    row.optString("uri"), row.optLong("modified"),
+                )
+                items[item.id] = item
+            }
+        }.onFailure { Log.w("KBrowserDownload", "Unable to load saved transfers", it) }
+    }
+
+    private fun save() {
+        val array = JSONArray()
+        items.values.forEach { item ->
+            array.put(JSONObject().apply {
+                put("id", item.id); put("url", item.url); put("title", item.title)
+                put("mime", item.mime); put("referer", item.referer); put("status", item.status)
+                put("bytes", item.bytes); put("total", item.total); put("etag", item.etag)
+                put("uri", item.uri); put("modified", item.modified)
+            })
+        }
+        app.getSharedPreferences("kbrowser_downloads", Context.MODE_PRIVATE)
+            .edit().putString("items", array.toString()).apply()
+    }
+
+    fun list(context: Context): List<Item> {
+        initialize(context)
+        return synchronized(lock) { items.values.sortedByDescending { it.modified }.take(100) }
+    }
+
+    fun enqueue(context: Context, url: String, title: String, mime: String?, referer: String): Long {
+        initialize(context)
+        val id = synchronized(lock) {
+            var next = System.currentTimeMillis()
+            while (items.containsKey(next)) next++
+            val item = Item(next, url, title, mime.orEmpty(), referer, RUNNING, 0, -1, "", "",
+                System.currentTimeMillis())
+            items[next] = item
+            save()
+            next
+        }
+        start(id)
+        return id
+    }
+
+    fun pause(context: Context, id: Long) {
+        initialize(context)
+        synchronized(lock) {
+            val item = items[id] ?: return
+            if (item.status != RUNNING) return
+            items[id] = item.copy(status = PAUSED, modified = System.currentTimeMillis())
+            active[id]?.stop()
+            save()
+        }
+    }
+
+    fun resume(context: Context, id: Long) {
+        initialize(context)
+        val previous = synchronized(lock) {
+            val item = items[id] ?: return
+            if (item.status != PAUSED && item.status != FAILED) return
+            items[id] = item.copy(status = RUNNING, modified = System.currentTimeMillis())
+            save()
+            active[id]
+        }
+        pool.execute {
+            previous?.done?.await()
+            start(id)
+        }
+    }
+
+    fun delete(context: Context, id: Long) {
+        initialize(context)
+        val removed = synchronized(lock) {
+            active.remove(id)?.stop()
+            items.remove(id).also { save() }
+        } ?: return
+        partial(id).delete()
+        if (removed.uri.isNotEmpty()) runCatching { app.contentResolver.delete(Uri.parse(removed.uri), null, null) }
+    }
+
+    private fun partial(id: Long): File = File(app.filesDir, "downloads/$id.part").apply {
+        parentFile?.mkdirs()
+    }
+
+    private fun start(id: Long) {
+        val transfer = Transfer()
+        synchronized(lock) {
+            if (items[id]?.status != RUNNING) return
+            active[id] = transfer
+        }
+        pool.execute { run(id, transfer) }
+    }
+
+    private fun run(id: Long, transfer: Transfer) {
+        var lastSaved = 0L
+        try {
+            val item = synchronized(lock) { items[id] } ?: return
+            val file = partial(id)
+            val offset = file.length()
+            val connection = (URL(item.url).openConnection() as HttpURLConnection).apply {
+                connectTimeout = 15000
+                readTimeout = 15000
+                setRequestProperty("User-Agent", "Mozilla/5.0 KEMIBrowser/1.0")
+                if (item.referer.startsWith("http")) setRequestProperty("Referer", item.referer)
+                if (offset > 0) {
+                    setRequestProperty("Range", "bytes=$offset-")
+                    if (item.etag.isNotEmpty()) setRequestProperty("If-Range", item.etag)
+                }
+            }
+            transfer.connection = connection
+            val code = connection.responseCode
+            if (code != HttpURLConnection.HTTP_OK && code != HttpURLConnection.HTTP_PARTIAL) {
+                error("HTTP $code")
+            }
+            val rangeStart = connection.getHeaderField("Content-Range")
+                ?.substringAfter("bytes ")?.substringBefore('-')?.toLongOrNull()
+            val append = code == HttpURLConnection.HTTP_PARTIAL && rangeStart == offset
+            if (code == HttpURLConnection.HTTP_PARTIAL && !append) error("Unexpected Content-Range")
+            val startBytes = if (append) offset else 0L
+            val total = connection.getHeaderField("Content-Range")?.substringAfter('/')?.toLongOrNull()
+                ?: connection.contentLengthLong.takeIf { it >= 0 }?.plus(startBytes) ?: -1L
+            synchronized(lock) {
+                items[id]?.let {
+                    items[id] = it.copy(bytes = startBytes, total = total,
+                        etag = connection.getHeaderField("ETag").orEmpty(),
+                        modified = System.currentTimeMillis())
+                    save()
+                }
+            }
+            connection.inputStream.use { input ->
+                FileOutputStream(file, append).use { output ->
+                    val buffer = ByteArray(64 * 1024)
+                    var downloaded = startBytes
+                    while (!transfer.stopped) {
+                        val count = input.read(buffer)
+                        if (count < 0) break
+                        output.write(buffer, 0, count)
+                        downloaded += count
+                        val now = System.currentTimeMillis()
+                        if (now - lastSaved > 500) {
+                            synchronized(lock) {
+                                items[id]?.let { items[id] = it.copy(bytes = downloaded, modified = now); save() }
+                            }
+                            lastSaved = now
+                        }
+                    }
+                    if (transfer.stopped) return
+                }
+            }
+            if (total >= 0 && file.length() != total) error("Incomplete response")
+            if (transfer.stopped) return
+            val saved = synchronized(lock) { items[id] } ?: return
+            val uri = publish(file, saved)
+            synchronized(lock) {
+                if (items[id] == null || transfer.stopped) {
+                    app.contentResolver.delete(uri, null, null)
+                } else {
+                    items[id] = saved.copy(status = COMPLETE, bytes = file.length(),
+                        total = file.length(), uri = uri.toString(), modified = System.currentTimeMillis())
+                    save()
+                    file.delete()
+                }
+            }
+        } catch (error: Exception) {
+            if (!transfer.stopped) {
+                Log.w("KBrowserDownload", "Transfer failed id=$id", error)
+                synchronized(lock) {
+                    items[id]?.let {
+                        items[id] = it.copy(status = FAILED, bytes = partial(id).length(),
+                            modified = System.currentTimeMillis())
+                        save()
+                    }
+                }
+            }
+        } finally {
+            transfer.connection?.disconnect()
+            synchronized(lock) { if (active[id] === transfer) active.remove(id) }
+            transfer.done.countDown()
+        }
+    }
+
+    private fun publish(file: File, item: Item): Uri {
+        require(Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) { "MediaStore Downloads requires Android 10" }
+        val resolver = app.contentResolver
+        val values = ContentValues().apply {
+            put(MediaStore.Downloads.DISPLAY_NAME, item.title)
+            put(MediaStore.Downloads.MIME_TYPE, item.mime.ifBlank { "application/octet-stream" })
+            put(MediaStore.Downloads.RELATIVE_PATH,
+                Environment.DIRECTORY_DOWNLOADS + "/KEMIBrowser/")
+            put(MediaStore.Downloads.IS_PENDING, 1)
+        }
+        val uri = resolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values)
+            ?: error("Unable to create download")
+        try {
+            resolver.openOutputStream(uri, "w")?.use { output -> file.inputStream().use { it.copyTo(output) } }
+                ?: error("Unable to write download")
+            resolver.update(uri, ContentValues().apply { put(MediaStore.Downloads.IS_PENDING, 0) }, null, null)
+            return uri
+        } catch (error: Exception) {
+            resolver.delete(uri, null, null)
+            throw error
+        }
+    }
+}
