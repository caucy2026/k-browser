+    private fun notebook(text: String): String = try {
+        val notebook = JSONObject(text)
+        val cells = notebook.optJSONArray("cells") ?: return codeBlock(prettyJson(text), "Jupyter Notebook JSON")
+        val output = StringBuilder("<p class=meta>Jupyter Notebook · 按单元格顺序离线阅读</p>")
+        for (index in 0 until minOf(cells.length(), 5_000)) {
+            val cell = cells.optJSONObject(index) ?: continue
+            val type = cell.optString("cell_type", "cell")
+            val source = jsonText(cell.opt("source"))
+            output.append("<section class=cell><h2>单元格 ${index + 1} · ${escape(type)}</h2>")
+            if (type == "markdown") {
+                output.append(markdown(source))
+            } else {
+                output.append("<pre><code>${escape(source.take(MAX_TEXT_CHARS))}</code></pre>")
+            }
+            val outputs = cell.optJSONArray("outputs")
+            if (outputs != null && outputs.length() > 0) {
+                val rendered = StringBuilder()
+                for (outputIndex in 0 until minOf(outputs.length(), 200)) {
+                    val item = outputs.optJSONObject(outputIndex) ?: continue
+                    val plain = item.optJSONObject("data")?.opt("text/plain") ?: item.opt("text")
+                    rendered.append(jsonText(plain))
+                }
+                if (rendered.isNotBlank()) {
+                    output.append("<h3>输出</h3><pre><code>${escape(rendered.toString().take(MAX_TEXT_CHARS))}</code></pre>")
+                }
+            }
+            output.append("</section>")
+            if (output.length >= MAX_HTML_CHARS / 2) break
+        }
+        output.toString()
+    } catch (_: Exception) {
+        codeBlock(prettyJson(text), "Jupyter Notebook JSON")
     }
 
+    private fun jsonText(value: Any?): String = when (value) {
+        is JSONArray -> buildString {
+            for (index in 0 until value.length()) append(value.optString(index))
+        }
+        null, JSONObject.NULL -> ""
+        else -> value.toString()
+    }
